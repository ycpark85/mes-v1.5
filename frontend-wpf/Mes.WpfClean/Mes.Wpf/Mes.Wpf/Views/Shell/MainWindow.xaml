<Window x:Class="Mes.Wpf.Views.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:defectViews="clr-namespace:Mes.Wpf.Modules.DefectTypes.Views"
        xmlns:routingViews="clr-namespace:Mes.Wpf.Modules.RoutingTemplates.Views"
        Title="MES"
        Width="1660"
        Height="980"
        MinWidth="1400"
        MinHeight="860"
        Style="{StaticResource ShellWindowStyle}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0B1F33"/>
        <SolidColorBrush x:Key="SidebarBackgroundDarkBrush" Color="#071827"/>
        <SolidColorBrush x:Key="SidebarHeaderBrush" Color="#0A3A64"/>
        <SolidColorBrush x:Key="SidebarHeaderLogoBrush" Color="#0C4C82"/>
        <SolidColorBrush x:Key="SidebarHoverBrush" Color="#123A5A"/>
        <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#0D6FD3"/>
        <SolidColorBrush x:Key="SidebarTextBrush" Color="#D8E6F3"/>
        <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="#8FA8BF"/>

        <Style x:Key="SidebarMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="28,1,10,1"/>
            <Setter Property="Padding" Value="16,0,8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource SidebarHoverBrush}"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource SidebarSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarHomeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SidebarMenuButtonStyle}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="20,0,8,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SidebarCategoryExpanderStyle" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <EventSetter Event="Expanded" Handler="MenuExpander_Expanded"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle"
                                          Height="42"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Content="{TemplateBinding Header}"
                                          Background="Transparent"
                                          Foreground="{StaticResource SidebarTextBrush}"
                                          BorderBrush="Transparent"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderRoot"
                                                Background="{TemplateBinding Background}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="32"/>
                                                </Grid.ColumnDefinitions>

                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="20,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"/>

                                                <TextBlock x:Name="ArrowText"
                                                           Grid.Column="1"
                                                           Text="›"
                                                           FontSize="18"
                                                           Foreground="{StaticResource SidebarMutedTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderRoot"
                                                        Property="Background"
                                                        Value="{StaticResource SidebarHoverBrush}"/>
                                            </Trigger>

                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="HeaderRoot"
                                                        Property="Background"
                                                        Value="{StaticResource SidebarHoverBrush}"/>
                                                <Setter TargetName="ArrowText"
                                                        Property="Text"
                                                        Value="⌄"/>
                                                <Setter TargetName="ArrowText"
                                                        Property="Foreground"
                                                        Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="ContentSite"
                                    Visibility="Collapsed"
                                    Padding="0,4,0,8"
                                    Background="#081B2C">
                                <ContentPresenter ContentSource="Content"/>
                            </Border>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentSite"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}">

            <DockPanel LastChildFill="True">

                <!-- Brand -->
                <Border DockPanel.Dock="Top"
                        Height="64"
                        Background="{StaticResource SidebarHeaderBrush}"
                        BorderBrush="#1F5C8E"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource SidebarHeaderLogoBrush}">
                            <TextBlock Text="SEMI"
                                       Foreground="White"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Text="MES"
                                   Foreground="#E5F1FF"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Bottom -->
                <Border DockPanel.Dock="Bottom"
                        Height="48"
                        Background="{StaticResource SidebarBackgroundDarkBrush}"
                        BorderBrush="#17344F"
                        BorderThickness="0,1,0,0">
                    <TextBlock Text="‹  메뉴 접기"
                               Foreground="{StaticResource SidebarTextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                </Border>

                <!-- Menu -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel x:Name="SidebarMenuStack"
                                Margin="0,12,0,12">

                        <Button x:Name="DashboardMenuButton"
                                Content="⌂  홈"
                                Style="{StaticResource SidebarHomeButtonStyle}"
                                Click="Dashboard_Click"/>
                        
                        <Button x:Name="MyPageMenuButton"
                                Content="👤 마이페이지"
                                Style="{StaticResource SidebarHomeButtonStyle}"
                                Click="MyPage_Click"/>  

                        <Expander Header="▣  기준정보"
                                  Style="{StaticResource SidebarCategoryExpanderStyle}"
                                  IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="PartnerMenuButton"
                                        Content="거래처관리"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="Partner_Click"/>

                                <Button x:Name="ProcessMenuButton"
                                        Content="공정관리"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="Process_Click"/>

                                <Button x:Name="RoutingTemplateMenuButton"
                                        Content="라우팅템플릿"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="RoutingTemplate_Click"/>

                                <Button x:Name="RoutingTemplateStepMenuButton"
                                        Content="라우팅템플릿스탭"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="RoutingTemplateStep_Click"/>

                                <Button x:Name="DrawingMenuButton"
                                        Content="도면관리"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="Drawing_Click"/>

                                <Button x:Name="PendingNewDrawingMenuButton"
                                        Content="신규작성도면"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="PendingNewDrawing_Click"/>

                                <Button x:Name="DefectTypeMenuButton"
                                        Content="불량유형"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="DefectType_Click"/>

                                <Button x:Name="ProductMenuButton"
                                        Content="품목관리"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="Product_Click"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="▤  영업관리"
                                  Style="{StaticResource SidebarCategoryExpanderStyle}"
                                  IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="OrderLineCreateMenuButton"
                                        Content="발주등록"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="OrderLineCreate_Click"/>

                                <Button x:Name="OrderLineListMenuButton"
                                        Content="발주리스트"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="OrderLineList_Click"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="▦  생산관리"
                                  Style="{StaticResource SidebarCategoryExpanderStyle}"
                                  IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="ProductionDailyMenuButton"
                                        Content="생산진행현황"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="ProductionDaily_Click"/>

                                <Button x:Name="LotProcessMenuButton"
                                        Content="LOT 관리"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="LotProcess_Click"/>

                                <Button x:Name="ProductMonitoringMenuButton"
                                        Content="품목이력관리"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="ProductMonitoring_Click"/>

                                <Button x:Name="OutsourceProcessingCostMenuButton"
                                        Content="외주가공비 관리"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="OutsourceProcessingCost_Click"/>

                                <Button x:Name="InventoryMenuButton"
                                        Content="재고 관리"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="Inventory_Click"/>
                                <Button x:Name="ShipmentMenuButton"
                                        Content="출하 관리"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="Shipment_Click"/>   
                            </StackPanel>
                        </Expander>

                        <Expander Header="⚙  외주관리"
                                  Style="{StaticResource SidebarCategoryExpanderStyle}"
                                  IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="OutsourceWorkInstructionMenuButton"
                                        Content="외주 작업지시"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="OutsourceWorkInstruction_Click"/>

                                <Button x:Name="OutsourceWorkInstructionListMenuButton"
                                        Content="외주 작업지시 리스트"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="OutsourceWorkInstructionList_Click"/>

                                <Button x:Name="OutsourcePurchaseOrderMenuButton"
                                        Content="외주 발주서 작성 / 출력"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="OutsourcePurchaseOrder_Click"/>

                                <Button x:Name="OutsourcePurchaseOrderListMenuButton"
                                        Content="외주발주 리스트"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="OutsourcePurchaseOrderList_Click"/>

                                <Button x:Name="BohyunOutsourceManagementMenuButton"
                                        Content="보현문화 외주관리"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="BohyunOutsourceManagement_Click"/>

                                <Button x:Name="BohyunOutsourceShipmentListMenuButton"
                                        Content="보현문화 출고리스트"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="BohyunOutsourceShipmentList_Click"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="☑  품질관리"
                                  Style="{StaticResource SidebarCategoryExpanderStyle}"
                                  IsExpanded="False">
                            <StackPanel>
                                <Button x:Name="InspectionWorkInstructionMenuButton"
                                        Content="검수 작업지시 / 등록"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="InspectionWorkInstruction_Click"/>

                                <Button x:Name="InspectionScheduleManagementMenuButton"
                                        Content="검수스케쥴관리"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="InspectionScheduleManagement_Click"/>

                                <Button x:Name="InspectionResultManagementMenuButton"
                                        Content="검수실적관리"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="InspectionResultManagement_Click"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="☑ 회원관리"
                                  Style="{StaticResource SidebarCategoryExpanderStyle}"
                                  IsExpanded="False">   
                            <StackPanel>
                                <Button x:Name="UserManagementMenuButton"
                                        Content="회원 관리"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="UserManagement_Click"/>
                                <Button x:Name="RoleManagementMenuButton"
                                        Content="역할/권한 관리"
                                        Style="{StaticResource SidebarMenuButtonStyle}"
                                        Click="RoleManagement_Click"/>      

                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ShellHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock x:Name="HeaderTitle"
                                   Text="MES 프로그램"
                                   FontSize="24"
                                   FontWeight="Bold"/>

                        

                        <TextBlock x:Name="HeaderSubtitle"
                                   Text="프론트엔드 아키텍처 베이스"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                             Content="새창"
                             Style="{StaticResource PrimaryButtonStyle}"
                             Click="OpenNewMainWindow_Click"
                             VerticalAlignment="Center"/>       

                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ContentControl x:Name="MainContent"
                                Visibility="Visible"/>
            </Grid>
        </Grid>
    </Grid>
</Window>

                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.WarningHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.WarningPressed}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.WarningPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />

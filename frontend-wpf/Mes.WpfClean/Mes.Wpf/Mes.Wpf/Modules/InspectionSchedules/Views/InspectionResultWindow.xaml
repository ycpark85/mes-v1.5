<Window x:Class="Mes.Wpf.Modules.InspectionSchedules.Views.InspectionResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="검수실적등록"
        Width="1180"
        Height="820"
        MinWidth="1050"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="SubSectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridTextBoxStyle" TargetType="TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="GridComboBoxStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 기본 정보 / 출고 목표 요약 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <!-- 기본 정보 -->
                <Border Grid.Column="0" Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="기본 정보"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="LOT 번호"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding LotNo}"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="품목명"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ProductName}"/>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="거래처"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding PartnerName}"/>
                        </Grid>

                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="검수일자"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding InspectionDate, StringFormat=yyyy-MM-dd}"/>
                        </Grid>
                    </Grid>
                    
                    
                </Border>

                <!-- 수량 / 납기 정보 -->
                <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="수량 / 납기 정보"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="수주수량"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding OrderQty, StringFormat={}{0:N0}}"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="계획수량"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding PlanQty, StringFormat={}{0:N0}}"/>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="납기일"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding DueDate, StringFormat=yyyy-MM-dd}"/>
                        </Grid>

                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="검수수량"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding TotalQty, StringFormat={}{0:N0}}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 출고 / 재고 요약 -->
                <Border Grid.Column="4" Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="출고 / 재고 요약"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="현재고수량"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding CurrentStockQty, StringFormat={}{0:N0}}"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="출고목표수량"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ShipTargetQty, StringFormat={}{0:N0}}"/>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="기출하수량"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding AlreadyShippedQty, StringFormat={}{0:N0}}"/>
                        </Grid>

                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="남은출고목표"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding RemainingShipTargetQty, StringFormat={}{0:N0}}"/>
                        </Grid>

                        <Grid Grid.Row="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="출고수량합계"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ExpectedShipQty, StringFormat={}{0:N0}}"/>
                        </Grid>
                        <Grid Grid.Row="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="120"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
               FontWeight="SemiBold"
               Foreground="#374151"
               Text="FIFO 기존재고 LOT"/>

                            <DataGrid Grid.Row="2"
              ItemsSource="{Binding StockLots}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              HeadersVisibility="Column"
              RowHeaderWidth="0"
              GridLinesVisibility="Horizontal"
              Background="White"
              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="LOT 번호"
                                Binding="{Binding LotNo}"
                                Width="*"/>

                                    <DataGridTextColumn Header="재고수량"
                                Binding="{Binding StockQty, StringFormat={}{0:N0}}"
                                Width="90"/>

                                    <DataGridTextColumn Header="출고 예정"
                                Binding="{Binding AllocatedShipQty, StringFormat={}{0:N0}}"
                                Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 검수 수량 / 출고 입력 -->
            <Border Grid.Row="2" Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="검수수량 및 출고/재고 처리"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 검수 결과 수량 -->
                        <Border Grid.Column="0" Style="{StaticResource SubSectionBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="검수 결과"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="양품수량"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             IsReadOnly="{Binding IsReadOnlyMode}"
                                             Text="{Binding GoodQty, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="불량출고수량"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             IsReadOnly="{Binding IsReadOnlyMode}"
                                             Text="{Binding DefectShipQty, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="불량수량"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             IsReadOnly="{Binding IsReadOnlyMode}"
                                             Text="{Binding DefectQty, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Grid.Row="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="미검수수량"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             IsReadOnly="{Binding IsReadOnlyMode}"
                                             Text="{Binding UninspectedQty, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Grid.Row="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="판매가능수량"/>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource ValueTextStyle}"
                                               Text="{Binding SellableQty, StringFormat={}{0:N0}}"/>
                                </Grid>

                                <Grid Grid.Row="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="총입고수량"/>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource ValueTextStyle}"
                                               Text="{Binding ReceivedQty, StringFormat={}{0:N0}}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 출고 / 재고 처리 -->
                        <Border Grid.Column="2" Style="{StaticResource SubSectionBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="출고 / 재고 처리"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="재고 출고수량"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             IsEnabled="{Binding IsShipmentInputEnabled}"
                                             IsReadOnly="{Binding IsReadOnlyMode}"
                                             Text="{Binding StockShipQty, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="생산 출고수량"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             IsEnabled="{Binding IsShipmentInputEnabled}"
                                             IsReadOnly="{Binding IsReadOnlyMode}"
                                             Text="{Binding ResultShipQty, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="폐기수량"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             IsEnabled="{Binding IsShipmentInputEnabled}"
                                             IsReadOnly="{Binding IsReadOnlyMode}"
                                             Text="{Binding DiscardQty, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                <Grid Grid.Row="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="재고편입수량"/>
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource ReadOnlyTextBoxStyle}"
                                             Text="{Binding StockInQty, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                </Grid>

                                <Grid Grid.Row="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="출고수량합계"/>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource ValueTextStyle}"
                                               Text="{Binding ExpectedShipQty, StringFormat={}{0:N0}}"/>
                                </Grid>

                                <Grid Grid.Row="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="총폐기수량"/>
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource ValueTextStyle}"
                                               Text="{Binding TotalDisposalQty, StringFormat={}{0:N0}}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 누적 / 부족 -->
                        <Border Grid.Column="4" Style="{StaticResource SubSectionBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="누적 / 부족 정보"/>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="누적양품"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding AccumulatedGoodQty, StringFormat={}{0:N0}}"/>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="누적불량"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding AccumulatedDefectQty, StringFormat={}{0:N0}}"/>
                                </Grid>

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="누적검수"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding AccumulatedInspectedQty, StringFormat={}{0:N0}}"/>
                                </Grid>

                                <Grid Grid.Row="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="누적입고"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding AccumulatedReceivedQty, StringFormat={}{0:N0}}"/>
                                </Grid>

                                <Grid Grid.Row="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource LabelTextStyle}" Text="예상부족수량"/>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ShortageQty, StringFormat={}{0:N0}}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 불량 내역 / 사진 -->
            <Border Grid.Row="4" Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="90"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Left"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">     
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Text="불량 내역"/>   

                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="90"
                                    Content="불량추가"
                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{Binding AddDefectCommand}"/>  
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Defects}"
                              SelectedItem="{Binding SelectedDefect, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              RowHeaderWidth="0"
                              IsReadOnly="{Binding IsReadOnlyMode}"
                              
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="불량유형 검색" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Height="26"
                                                 Style="{StaticResource GridTextBoxStyle}"
                                                 Padding="4,0"
                                                 IsReadOnly="{Binding DataContext.IsReadOnlyMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Text="{Binding DefectCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="{Binding}"
                                                 KeyDown="DefectTypeIdTextBox_KeyDown"/>    
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="불량코드"
                                                Binding="{Binding DefectCode}"
                                                IsReadOnly="True"
                                                Width="85"
                                                ElementStyle="{StaticResource GridTextStyle}"/> 

                            <DataGridTextColumn Header="대분류"
                                                Binding="{Binding Category1Name}"
                                                IsReadOnly="True"
                                                Width="105"
                                                ElementStyle="{StaticResource GridTextStyle}"/> 

                            <DataGridTextColumn Header="소분류"
                                                Binding="{Binding Category2Name}"
                                                IsReadOnly="True"
                                                Width="105"
                                                ElementStyle="{StaticResource GridTextStyle}"/>     

                            <DataGridTemplateColumn Header="처리구분" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Height="26"
                                                  Style="{StaticResource GridComboBoxStyle}"
                                                  IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValue="{Binding Disposition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Content="출고불가" Tag="NOT_SHIPPABLE"/>
                                            <ComboBoxItem Content="불량출고" Tag="SHIP_AS_IS"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="불량수량" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Height="26"
                                                 Style="{StaticResource GridTextBoxStyle}"
                                                 Padding="4,0"
                                                 IsReadOnly="{Binding DataContext.IsReadOnlyMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Text="{Binding DefectQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="메모" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,4"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DefectTypeMemo}"
                                                       TextWrapping="Wrap"
                                                       HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Center"
                                                       Foreground="#111827"/>       
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox MinHeight="52"
                                                 Padding="6,4"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 TextAlignment="Center"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 Text="{Binding DefectTypeMemo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>    
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="사진" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="업로드"
                                    Height="26"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{Binding DataContext.UploadPhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="삭제" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="삭제"
                                    Height="26"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{Binding DataContext.RemoveDefectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="4"
                   FontWeight="SemiBold"
                   Foreground="#374151"
                   Text="선택 불량 사진"/>

                    <Border Grid.Row="6"
                Background="#F8FAFC"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
                        <ListBox ItemsSource="{Binding SelectedDefect.Attachments}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right"
                                    Width="50"
                                    Height="24"
                                    Content="삭제"
                                    Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>

                                        <Button DockPanel.Dock="Right"
                                                Width="50"
                                                Height="24"
                                                Margin="0,0,6,0"
                                                Content="보기"
                                                Command="{Binding DataContext.OpenPhotoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>

                                        <TextBlock VerticalAlignment="Center"
                                       Text="{Binding FileName}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>

            <!-- 메모 / 분할검수 / 저장 -->
            <Border Grid.Row="6" Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 특이사항 -->
                    <Border Grid.Row="0" Style="{StaticResource SubSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                           FontWeight="SemiBold"
                           Text="특이사항"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                               Style="{StaticResource LabelTextStyle}"
                               Text="메모"/>

                                <TextBox Grid.Column="1"
                             MinHeight="78"
                             Padding="8,6"
                             VerticalContentAlignment="Top"
                             AcceptsReturn="True"
                             IsReadOnly="{Binding IsReadOnlyMode}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 분할검수 -->
                    <Border Grid.Row="2" Style="{StaticResource SubSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                           FontWeight="SemiBold"
                           Text="분할검수"/>

                            <CheckBox Grid.Row="2"
                          VerticalAlignment="Center"
                          Content="분할검수 사용"
                          IsEnabled="{Binding CanEdit}"
                          IsChecked="{Binding IsPartial, Mode=TwoWay}"/>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                               Style="{StaticResource LabelTextStyle}"
                               Text="다음 검수일"/>

                                <DatePicker Grid.Column="1"
                                Height="30"
                                IsEnabled="{Binding CanEdit}"
                                SelectedDate="{Binding NextInspectionDate, Mode=TwoWay}"/>

                                <TextBlock Grid.Column="2"
                               Margin="16,0,0,0"
                               Style="{StaticResource LabelTextStyle}"
                               Text="사유"/>

                                <TextBox Grid.Column="3"
                             Margin="8,0,0,0"
                             Height="30"
                             Padding="6,0"
                             VerticalContentAlignment="Center"
                             IsReadOnly="{Binding IsReadOnlyMode}"
                             Text="{Binding PartialReason, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource SubSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0">
                                <TextBlock FontWeight="SemiBold" Text="회차별 검수 이력"/>
                                <TextBlock DockPanel.Dock="Right"
                                           Foreground="#6B7280"
                                           Text="{Binding InspectionRoundDisplay}"/>
                            </DockPanel>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding Rounds}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      MaxHeight="180"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="회차" Width="60" Binding="{Binding InspectionRound, StringFormat={}{0}차}" ElementStyle="{StaticResource GridTextStyle}"/>
                                    <DataGridTextColumn Header="검수일자" Width="100" Binding="{Binding InspectionDate, StringFormat=yyyy-MM-dd}" ElementStyle="{StaticResource GridTextStyle}"/>
                                    <DataGridTextColumn Header="구분" Width="70" Binding="{Binding ResultTypeDisplay}" ElementStyle="{StaticResource GridTextStyle}"/>
                                    <DataGridTextColumn Header="양품" Width="80" Binding="{Binding GoodQty, StringFormat={}{0:N0}}" ElementStyle="{StaticResource GridTextStyle}"/>
                                    <DataGridTextColumn Header="불량출고" Width="90" Binding="{Binding DefectShipQty, StringFormat={}{0:N0}}" ElementStyle="{StaticResource GridTextStyle}"/>
                                    <DataGridTextColumn Header="불량" Width="80" Binding="{Binding DefectQty, StringFormat={}{0:N0}}" ElementStyle="{StaticResource GridTextStyle}"/>
                                    <DataGridTextColumn Header="총 입고" Width="90" Binding="{Binding ReceivedQty, StringFormat={}{0:N0}}" ElementStyle="{StaticResource GridTextStyle}"/>
                                    <DataGridTextColumn Header="다음 검수일" Width="105" Binding="{Binding NextInspectionDate, StringFormat=yyyy-MM-dd}" ElementStyle="{StaticResource GridTextStyle}"/>
                                    <DataGridTextColumn Header="분할사유" Width="*" Binding="{Binding PartialReason}" ElementStyle="{StaticResource GridTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="6"
                               Foreground="#6B7280"
                               Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}"
                               Text="저장 시 입력한 출고수량은 출고 이력으로 기록되고 실제 재고가 차감됩니다. 남은 판매가능수량은 재고로 편입됩니다."/>

                    <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0"
                                Content="수정"
                                Visibility="{Binding CanRequestEdit, Converter={StaticResource BoolToVisibilityConverter}}"
                                Command="{Binding EditCommand}"/>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0"
                                Content="저장"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibilityConverter}}"
                                Command="{Binding SaveCommand}"/>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{Binding CloseButtonText}"
                                Command="{Binding CancelCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>

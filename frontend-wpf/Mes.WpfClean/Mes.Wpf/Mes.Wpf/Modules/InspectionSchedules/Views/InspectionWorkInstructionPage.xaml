<UserControl x:Class="Mes.Wpf.Modules.InspectionSchedules.Views.InspectionWorkInstructionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">
                <Button Content="새로고침"
                        Width="100"
                        Height="34"
                        Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}" />
                <Button Content="선택해제"
                        Width="100"
                        Height="34"
                        Command="{Binding ClearSelectionCommand}" />
            </StackPanel>
        </DockPanel>
        <TextBlock Text="{Binding TotalCount, StringFormat=Total : {0}건}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />      
        <Border Grid.Row="2"
                BorderBrush="#D9DDE3"
                BorderThickness="1"
                CornerRadius="4"
                Background="White">
            <DataGrid ItemsSource="{Binding Items}"
          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True"
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal"
          RowHeaderWidth="0"
          RowHeight="34"
          SelectionMode="Single">

                <DataGrid.Resources>
                    <Style x:Key="CenteredTextBlockStyle" TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Center" />
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </DataGrid.Resources>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="TextBlock.TextAlignment" Value="Center" />
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Height" Value="38" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="LOT 번호"
                                        Binding="{Binding LotNo}"
                                        Width="130"
                                        ElementStyle="{StaticResource CenteredTextBlockStyle}" />
                    
                    <DataGridTextColumn Header="묶음번호"
                                        Binding="{Binding BundleNo}"
                                        Width="150"
                                        IsReadOnly="True"/> 

                    <DataGridTextColumn Header="품목코드"
                                        Binding="{Binding ProductCode}"
                                        Width="120"
                                        ElementStyle="{StaticResource CenteredTextBlockStyle}" />
                    <DataGridTextColumn Header="MES 코드" Binding="{Binding MesProductCode}" Width="140" ElementStyle="{StaticResource CenteredTextBlockStyle}"/>

                    <DataGridTextColumn Header="품목명"
                                        Binding="{Binding ProductName}"
                                        Width="350"
                                        ElementStyle="{StaticResource CenteredTextBlockStyle}" />       

                    <DataGridTextColumn Header="고객사"
                                        Binding="{Binding PartnerName}"
                                        Width="160"
                                        ElementStyle="{StaticResource CenteredTextBlockStyle}" />           

                    <DataGridTextColumn Header="LOT 수량"
                                        Binding="{Binding LotQty, StringFormat=N0}"
                                        Width="100"
                                        ElementStyle="{StaticResource CenteredTextBlockStyle}" />       

                    <DataGridTextColumn Header="납기일"
                                        Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}"
                                        Width="120"
                                        ElementStyle="{StaticResource CenteredTextBlockStyle}" />   

                    <DataGridTextColumn Header="비고"
                                        Binding="{Binding Memo}"
                                        Width="*"
                                        ElementStyle="{StaticResource CenteredTextBlockStyle}" />       

                   
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="4"
                Padding="16"
                BorderBrush="#D9DDE3"
                BorderThickness="1"
                CornerRadius="4"
                Background="White">     
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1행 -->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="LOT 번호"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>       
        
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Height="28"
                         VerticalContentAlignment="Center"
                         Text="{Binding EditModel.LotNo}"
                         IsReadOnly="True"/>        

                <TextBlock Grid.Row="0"
                           Grid.Column="3"
                           Text="품목코드"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>       

                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBox Height="28" VerticalContentAlignment="Center" Text="{Binding EditModel.ProductCode}" IsReadOnly="True"/>
                    <TextBlock Margin="0,4,0,0" Foreground="#64748B" Text="{Binding EditModel.MesProductCode, StringFormat=MES 코드: {0}}"/>
                </StackPanel>

                <TextBlock Grid.Row="0"
                           Grid.Column="6"
                           Text="품목명"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>       

                <TextBox Grid.Row="0"
                         Grid.Column="7"
                         Height="28"
                         VerticalContentAlignment="Center"
                         Text="{Binding EditModel.ProductName}"
                         IsReadOnly="True"/>        

                <!-- 2행 -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="고객사"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>   

                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Height="28"
                         VerticalContentAlignment="Center"
                         Text="{Binding EditModel.PartnerName}"
                         IsReadOnly="True"/>    

                <TextBlock Grid.Row="2"
                           Grid.Column="3"
                           Text="검수일"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>       

                <DatePicker Grid.Row="2"
                            Grid.Column="4"
                            Height="28"
                            VerticalAlignment="Center"
                            SelectedDate="{Binding EditModel.InspectionDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>       

                <!-- 3행 -->
                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="특이사항"
                           VerticalAlignment="Top"
                           Margin="0,4,8,0"/>       

                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Grid.ColumnSpan="7"
                         Height="78"
                         Padding="8,6"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         Background="#F5F7FA"
                         Text="{Binding EditModel.Memo, Mode=OneWay}"/>        

                <!-- 버튼 -->
                <StackPanel Grid.Row="6"
                            Grid.Column="0"
                            Grid.ColumnSpan="8"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">        
                    <Button Content="선택해제"
                            Width="100"
                            Height="32"
                            Margin="0,0,8,0"
                            Command="{Binding ClearSelectionCommand}" />        
                    <Button Content="검수 작업지시 등록"
                            Width="150"
                            Height="32"
                            Command="{Binding RegisterCommand}" />      
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

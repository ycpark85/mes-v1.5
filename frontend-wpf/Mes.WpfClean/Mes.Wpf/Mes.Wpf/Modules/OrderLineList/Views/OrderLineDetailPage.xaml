<UserControl x:Class="Mes.Wpf.Modules.OrderLineList.Views.OrderLineDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Mes.Wpf.Core.Converters"
             mc:Ignorable="d" d:DesignWidth="1503.069">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:IntThousandsConverter x:Key="IntThousandsConverter" />
        <conv:OrderLineStatusToBrushConverter x:Key="OrderLineStatusToBrushConverter" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ReadOnlyValueBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,4,12,4"/>
        </Style>

        <Style x:Key="ReadOnlyValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D2E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        
    </UserControl.Resources>

    <Grid Margin="16" Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}"
                Padding="16,14">
            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           Text="수주 상세" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="#6B7280"
                           Text="수주 정보 및 LOT 진행 현황을 확인합니다." />
                <WrapPanel Margin="0,6,0,0">
                    <TextBlock Text="품목코드: "/><TextBlock Text="{Binding ProductCode}"/>
                    <TextBlock Margin="20,0,0,0" Text="MES 코드: "/><TextBlock Text="{Binding MesProductCode}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 본문 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <!-- 좌측 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 수주 기본 정보 -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="수주 기본 정보" />

                        <!-- 기본 정보 그리드 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <!-- 수주번호 -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="수주번호" />
                            <Border Grid.Row="0" Grid.Column="1"
                                    Style="{StaticResource ReadOnlyValueBorderStyle}">
                                <TextBlock Style="{StaticResource ReadOnlyValueTextStyle}"
                                           Text="{Binding OrderNo}" />
                            </Border>

                            <!-- 거래처 -->
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="거래처" />
                            <Border Grid.Row="0" Grid.Column="3"
                                    Margin="0,4,0,4"
                                    Style="{StaticResource ReadOnlyValueBorderStyle}">
                                <TextBlock Style="{StaticResource ReadOnlyValueTextStyle}"
                                           Text="{Binding PartnerName}" />
                            </Border>

                            <!-- 수주일자 -->
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="수주일자" />
                            <Border Grid.Row="1" Grid.Column="1"
                                    Style="{StaticResource ReadOnlyValueBorderStyle}">
                                <TextBlock Style="{StaticResource ReadOnlyValueTextStyle}"
                                           Text="{Binding OrderDate, StringFormat=yyyy-MM-dd}" />
                            </Border>

                            <!-- 품목 -->
                            <TextBlock Grid.Row="1" Grid.Column="2"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="품목" />
                            <Border Grid.Row="1" Grid.Column="3"
                                    Margin="0,4,0,4"
                                    Style="{StaticResource ReadOnlyValueBorderStyle}">
                                <TextBlock Style="{StaticResource ReadOnlyValueTextStyle}"
                                           Text="{Binding ProductName}" />
                            </Border>

                            <!-- 납기일 -->
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="납기일" />
                            <DatePicker Grid.Row="2" Grid.Column="1"
                                        Margin="0,4,12,4"
                                        SelectedDate="{Binding DueDate}"
                                        IsEnabled="{Binding IsEditMode}" />

                            <!-- 수주수량 -->
                            <TextBlock Grid.Row="2" Grid.Column="2"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="수주수량" />
                            <TextBox Grid.Row="2" Grid.Column="3"
                                     Margin="0,4,0,4"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     Text="{Binding OrderQty, Converter={StaticResource IntThousandsConverter}, UpdateSourceTrigger=PropertyChanged}" />    

                            <!-- 단위 -->
                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="단위" />
                            <Border Grid.Row="3" Grid.Column="1"
                                    Style="{StaticResource ReadOnlyValueBorderStyle}">
                                <TextBlock Style="{StaticResource ReadOnlyValueTextStyle}"
                                           Text="{Binding Uom}" />
                            </Border>

                            <!-- 상태 -->
                            <TextBlock Grid.Row="3" Grid.Column="2"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="상태" />
                            <Grid Grid.Row="3" Grid.Column="3" Margin="0,4,0,4">
                                <Border Background="{Binding Status, Converter={StaticResource OrderLineStatusToBrushConverter}}"
                                        CornerRadius="4"
                                        Padding="10,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Foreground="White"
                                               FontWeight="SemiBold"
                                               Text="{Binding StatusDisplay}" />
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- 메모 -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource LabelTextStyle}"
                                       VerticalAlignment="Top"
                                       Text="메모" />

                            <TextBox Grid.Column="1"
                                     Height="86"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     Text="{Binding Memo}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- LOT 목록 -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="LOT 목록" />

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Lots}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  MinHeight="240">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#EEF2F7"/>
                                    <Setter Property="Foreground" Value="#1F2937"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="36"/>
                                    <Setter Property="BorderBrush" Value="#D9DEE7"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="LOT 번호"
                                                    Binding="{Binding LotNo}"
                                                    Width="150" />

                                <DataGridTextColumn Header="LOT 유형"
                                                    Binding="{Binding LotType}"
                                                    Width="100" />

                                <DataGridTextColumn Header="LOT 계획수량"
                                                    Binding="{Binding LotQty, StringFormat={}{0:N0}}"
                                                    Width="120" />

                                <DataGridTextColumn Header="현재 공정"
                                                    Binding="{Binding CurrentProcessName}"
                                                    Width="150" />

                                <DataGridTextColumn Header="LOT 상태"
                                                    Binding="{Binding Status}"
                                                    Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 우측 타임라인 -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="진행 타임라인" />

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Timeline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 타임라인 도트/선 -->
                                        <Grid Grid.Column="0">
                                            <Ellipse Width="10"
                                                     Height="10"
                                                     Fill="#64748B"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Top"
                                                     Margin="0,4,0,0" />
                                            <Border Width="1"
                                                    Background="#D1D5DB"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,18,0,0" />
                                        </Grid>

                                        <!-- 타임라인 본문 -->
                                        <Border Grid.Column="1"
                                                Padding="0,0,0,12"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <TextBlock FontWeight="Bold"
                                                           FontSize="14"
                                                           Foreground="#111827"
                                                           Text="{Binding EventLabel}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="12"
                                                           Foreground="#6B7280"
                                                           Text="{Binding EventAt, StringFormat=yyyy-MM-dd HH:mm}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           TextWrapping="Wrap"
                                                           Foreground="#374151"
                                                           Text="{Binding Message}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 하단 버튼 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

          

            <Button Grid.Column="1"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="수정"
                    Command="{Binding EditCommand}"
                    IsEnabled="{Binding CanEditNow}" />

            <Button Grid.Column="3"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="저장"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSaveNow}" />

            <Button Grid.Column="5"
                    Style="{StaticResource DangerButtonStyle}"
                    Content="수주취소"
                    Command="{Binding CancelOrderCommand}"
                    IsEnabled="{Binding CanCancelOrder}" />

            <Button Grid.Column="7"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="기본 LOT 생성"
                    Command="{Binding CreateBaseLotCommand}"
                    IsEnabled="{Binding CanCreateBaseLot}" />

            <Button Grid.Column="9"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="LOT 상세"
                    Command="{Binding OpenLotDetailCommand}"
                    IsEnabled="{Binding HasSelectedLot}" />
        </Grid>
    </Grid>
</UserControl>
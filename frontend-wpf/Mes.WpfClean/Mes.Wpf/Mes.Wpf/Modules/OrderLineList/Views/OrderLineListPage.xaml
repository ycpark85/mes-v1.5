<UserControl x:Class="Mes.Wpf.Modules.OrderLineList.Views.OrderLineListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SubSectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#F5F7FA"
              Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 검색 영역 -->
            <Border Grid.Row="0"
                    Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Left"
                                    Orientation="Horizontal">
                            <Button Style="{StaticResource TabButtonStyle}"
                                    Margin="0,0,8,0"
                                    Content="생산중"
                                    Command="{Binding ShowInProgressCommand}"/>

                            <Button Style="{StaticResource TabButtonStyle}"
                                    Content="생산완료"
                                    Command="{Binding ShowCompletedCommand}"/>
                        </StackPanel>

                        
                    </DockPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource LabelTextStyle}"
                                   Text="수주일자"
                                   Visibility="{Binding IsDateFilterVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <DatePicker Grid.Column="1"
                                    Height="32"
                                    SelectedDate="{Binding OrderDateFrom}"
                                    Visibility="{Binding IsDateFilterVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="~"
                                   Visibility="{Binding IsDateFilterVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <DatePicker Grid.Column="3"
                                    Height="32"
                                    SelectedDate="{Binding OrderDateTo}"
                                    Visibility="{Binding IsDateFilterVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Grid.Column="5"
                                   Style="{StaticResource LabelTextStyle}"
                                   Text="검색어"/>

                        <TextBox Grid.Column="6"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Grid.Column="8"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="조회"
                                Command="{Binding SearchOrderLinesCommand}"/>

                        <Button Grid.Column="10"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="초기화"
                                Command="{Binding ResetOrderLineSearchCommand}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 리스트 영역 -->
            <Border Grid.Row="2"
                    Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="360"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="{Binding CurrentTabTitle}"/>

                        <TextBlock DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#6B7280"
                                   Text="{Binding PageInfoText}"/>
                        
                        <TextBlock DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#6B7280"
                                   Text="{Binding TotalCountText}"/>    
                    </DockPanel>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="수주번호"
                                                Binding="{Binding OrderNo}"
                                                Width="130"
                                                ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="라인"
                                                Binding="{Binding LineNo}"
                                                Width="70"
                                                ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="거래처"
                                                Binding="{Binding PartnerName}"
                                                Width="160"
                                                ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="품목코드"
                                                Binding="{Binding ProductCode}"
                                                Width="120"
                                                ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="품목명"
                                                Binding="{Binding ProductName}"
                                                Width="180"
                                                ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="수주수량"
                                                Binding="{Binding OrderQty, StringFormat={}{0:N0}}"
                                                Width="100"
                                                ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="출고목표"
                                                Binding="{Binding ShipTargetQty, StringFormat={}{0:N0}}"
                                                Width="100"
                                                ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="현재고"
                                                Binding="{Binding AvailableInventoryQty, StringFormat={}{0:N0}}"
                                                Width="100"
                                                ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="생산필요"
                                                Binding="{Binding PlannedProductionQty, StringFormat={}{0:N0}}"
                                                Width="100"
                                                ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="처리구분"
                                                Binding="{Binding PlanTypeDisplay}"
                                                Width="150"
                                                ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="상태"
                                                Binding="{Binding Status}"
                                                Width="90"
                                                ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="결정"
                                                Binding="{Binding DecisionStatusDisplay}"
                                                Width="90"
                                                ElementStyle="{StaticResource GridTextStyle}"/>

                            <DataGridTextColumn Header="LOT"
                                                Binding="{Binding HasLot}"
                                                Width="70"
                                                ElementStyle="{StaticResource GridTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                       
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0"
                                Content="이전"
                                IsEnabled="{Binding CanGoPreviousPage}"
                                Command="{Binding PreviousPageCommand}"/>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="다음"
                                IsEnabled="{Binding CanGoNextPage}"
                                Command="{Binding NextPageCommand}"/>
                           
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 액션 영역 -->
            <Border Grid.Row="4"
                    Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="#6B7280"
                               Text="선택한 발주의 상세 확인, 기본 LOT 생성, 재작업 LOT 생성을 진행할 수 있습니다."/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0"
                                Content="수주상세"
                                Command="{Binding OpenOrderDetailCommand}"/>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0"
                                Content="수주번호 전체 삭제"
                                Foreground="#B91C1C"
                                IsEnabled="{Binding CanDeleteOrderGroup}"
                                Command="{Binding DeleteOrderGroupCommand}"/>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0"
                                Content="기본 LOT 생성"
                                IsEnabled="{Binding CanCreateBaseLot}"
                                Command="{Binding CreateBaseLotCommand}"/>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="{Binding LotActionButtonText}"
                                Command="{Binding OpenLotActionCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 자동 처리계획 -->
            <Border Grid.Row="6"
                    Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsPlanningSectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="자동 처리계획"/>

                    <!-- 수량 요약 -->
                    <UniformGrid Grid.Row="2"
                                 Columns="4">
                        <Border Margin="0,0,8,0"
                                Style="{StaticResource SubSectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelTextStyle}"
                                           Text="출고목표수량"/>
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="{Binding ShipTargetQtyText}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,8,0"
                                Style="{StaticResource SubSectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelTextStyle}"
                                           Text="현재고수량"/>
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="{Binding AvailableInventoryQtyText}"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,8,0"
                                Style="{StaticResource SubSectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelTextStyle}"
                                           Text="재고사용예정"/>
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="{Binding StockUsePlanQtyText}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SubSectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelTextStyle}"
                                           Text="생산필요수량"/>
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="{Binding PlannedProductionQtyText}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- 처리 상태 -->
                    <Border Grid.Row="4"
                            Style="{StaticResource SubSectionBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="처리구분"/>

                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource ValueTextStyle}"
                                           Text="{Binding PlanTypeDisplayText}"/>

                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="결정상태"/>

                                <TextBlock Grid.Column="3"
                                           Style="{StaticResource ValueTextStyle}"
                                           Text="{Binding DecisionStatusText}"/>
                            </Grid>

                            <TextBlock Grid.Row="2"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"
                                       Text="{Binding AutoPlanGuideText}"/>
                        </Grid>
                    </Border>

                    <!-- 처리계획 선택 -->
                    <Border Grid.Row="6"
                            Style="{StaticResource SubSectionBorderStyle}"
                            Visibility="{Binding IsPlanDecisionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"
                                       Text="처리계획 선택"/>

                            <TextBlock Grid.Row="2"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"
                                       Text="재고 출고, 부족분 생산 또는 발주수량 전체 재고생산 중 서버가 허용한 처리방식을 선택하세요."/>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="처리방식"/>

                                <ComboBox Grid.Column="1"
                                          Height="30"
                                          ItemsSource="{Binding PlanOptions}"
                                          DisplayMemberPath="Value"
                                          SelectedValue="{Binding SelectedPlanType, Mode=TwoWay}"
                                          SelectedValuePath="Key"/>

                                <TextBlock Grid.Column="2"
                                           Margin="12,0,0,0"
                                           Style="{StaticResource LabelTextStyle}"
                                           Text="메모"/>

                                <TextBox Grid.Column="3"
                                         Height="30"
                                         Padding="6,0"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding PlanMemo, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Grid.Column="4"
                                        Margin="10,0,0,0"
                                         Height="30"
                                         MinWidth="90"
                                         Content="처리 확정"
                                         IsEnabled="{Binding CanConfirmPlan}"
                                         Command="{Binding ConfirmPlanCommand}"/>
                            </Grid>

                            <TextBlock Grid.Row="6"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"
                                       Text="재고 출고완료는 즉시 재고를 차감합니다. 부족분 생산은 현재고를 예약합니다. 재고생산은 기존 재고를 사용하지 않고 발주수량 그대로 LOT를 생성합니다."/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

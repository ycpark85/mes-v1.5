<Window x:Class="Mes.Wpf.Modules.Products.Views.PartnerProductMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="무지 품목 · 거래처 연결" Width="1040" Height="720" MinWidth="850" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9" FontFamily="Malgun Gothic">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4,0"/><Setter Property="MinHeight" Value="34"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="거래처별 ERP 코드 연결" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Margin="0,8,0,8" Text="{Binding ProductSummary}" FontSize="14" TextWrapping="Wrap"/>
            <TextBlock Text="같은 도면·제품을 쓰는 A·B업체는 함께 연결하세요. 다른 도면을 쓰는 업체는 별도 품목에 연결하세요.&#10;동일 품목에 연결하면 재고도 함께 관리됩니다. 연결을 고칠 때는 기존 연결을 해제하고 다시 추가하세요." Foreground="#475569" TextWrapping="Wrap"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,18,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="새로고침" Command="{Binding RefreshCommand}"/><Button Content="선택 연결 해제" Command="{Binding DeactivateCommand}"/></StackPanel>
            <TextBlock Text="연결 목록 / 이력" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DockPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedMapping}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" RowHeight="34" HeadersVisibility="Column" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="거래처" Binding="{Binding PartnerName}" Width="160"/>
                <DataGridTextColumn Header="ERP 코드" Binding="{Binding ErpProductCode}" Width="140"/>
                <DataGridTextColumn Header="거래처 품명" Binding="{Binding CustomerProductName}" Width="*"/>
                <DataGridTextColumn Header="규격" Binding="{Binding CustomerProductSpec}" Width="180"/>
                <DataGridTextColumn Header="상태" Binding="{Binding StatusDisplay}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,10,0,12">
            <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="이전" Command="{Binding PreviousCommand}"/><Button Content="다음" Command="{Binding NextCommand}"/></StackPanel><TextBlock Text="{Binding PageText}" VerticalAlignment="Center"/></DockPanel>
            <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475569" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Border Grid.Row="4" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16" IsEnabled="{Binding CanEdit}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="고객 거래처" VerticalAlignment="Center"/>
                <DockPanel Grid.Column="1"><Button DockPanel.Dock="Right" Content="찾기" Click="FindPartner_Click"/><TextBox Text="{Binding PartnerName, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="선택 거래처"/></DockPanel>
                <TextBlock Grid.Column="3" Text="ERP 코드" VerticalAlignment="Center"/>
                <TextBox Grid.Column="4" Text="{Binding ErpCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="ERP 품목코드"/>
                <TextBlock Grid.Row="1" Text="거래처 품명" Margin="0,12,0,0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="거래처 품명"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="규격" Margin="0,12,0,0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="4" Margin="0,12,0,0" Text="{Binding CustomerSpec, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="거래처 규격"/>
                <Button Grid.Row="2" Grid.Column="4" Margin="0,14,0,0" HorizontalAlignment="Right" Content="이 품목에 연결" Command="{Binding AddCommand}"/>
            </Grid>
        </Border>
        <Button Grid.Row="5" Margin="0,14,0,0" HorizontalAlignment="Right" Content="닫기" IsCancel="True" IsEnabled="{Binding CanEdit}"/>
    </Grid>
</Window>

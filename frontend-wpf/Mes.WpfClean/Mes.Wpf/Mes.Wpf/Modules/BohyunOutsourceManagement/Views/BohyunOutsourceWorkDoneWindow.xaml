<Window x:Class="Mes.Wpf.Modules.BohyunOutsourceManagement.Views.BohyunOutsourceWorkDoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보현문화 작업완료"
        Width="560"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="보현문화 작업완료"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,16"/>

            <TextBlock Text="거래처"/>
            <TextBox Text="{Binding EditModel.PartnerName}"
                     IsReadOnly="True"
                     Margin="0,0,0,10"/>

            <TextBlock Text="작업구분"/>
            <TextBox Text="{Binding EditModel.WorkTypeName}"
                     IsReadOnly="True"
                     Margin="0,0,0,10"/>

            <TextBlock Text="LOT"/>
            <TextBox Text="{Binding EditModel.LotNosText}"
                     IsReadOnly="True"
                     Margin="0,0,0,10"/>

            <TextBlock Text="{Binding EditModel.ProductCodesText, StringFormat=품목코드: {0}}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding EditModel.MesProductCodesText, StringFormat=MES 코드: {0}}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,10"/>
            <TextBlock Text="품목명"/>
            <TextBox Text="{Binding EditModel.ProductNamesText}"
                     IsReadOnly="True"
                     Margin="0,0,0,10"/>

            <TextBlock Text="발주 시트수"/>
            <TextBox Text="{Binding EditModel.SheetQty}"
                     IsReadOnly="True"
                     Margin="0,0,0,10"/>

            <TextBlock Text="완료 시트수"/>
            <TextBox Text="{Binding EditModel.WorkDoneSheetQty, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Text="외주가공비"/>
            <TextBox Text="{Binding EditModel.OutsourceProcessingFee, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,10"/>

            <TextBlock Text="비고"/>
            <TextBox Text="{Binding EditModel.Remark, UpdateSourceTrigger=PropertyChanged}"
                     Height="70"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="저장"
                    Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Command="{Binding SaveCommand}"/>

            <Button Content="취소"
                    Width="90"
                    Height="32"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>

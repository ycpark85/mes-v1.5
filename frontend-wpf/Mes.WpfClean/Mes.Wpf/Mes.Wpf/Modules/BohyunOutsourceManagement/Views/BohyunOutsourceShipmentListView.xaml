<UserControl x:Class="Mes.Wpf.Modules.BohyunOutsourceManagement.Views.BohyunOutsourceShipmentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="360"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16"
                Margin="0,0,0,12"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="시작일"/>
                    <DatePicker Width="130"
                                SelectedDate="{Binding DateFrom}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="종료일"/>
                    <DatePicker Width="130"
                                SelectedDate="{Binding DateTo}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="공정구분"/>
                    <ComboBox Width="120"
                              ItemsSource="{Binding ProcessTypeOptions}"
                              SelectedItem="{Binding SelectedProcessType}"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="검색어"/>
                    <TextBox Width="260"
                             Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <Button Content="조회"
                        Width="80"
                        Height="30"
                        Margin="0,18,8,0"
                        Command="{Binding SearchCommand}"/>

                <Button Content="초기화"
                        Width="80"
                        Height="30"
                        Margin="0,18,8,0"
                        Command="{Binding ResetCommand}"/>

                <Button Content="미리보기"
                        Width="90"
                        Height="30"
                        Margin="0,18,0,0"
                        Command="{Binding PrintCommand}"/>      
            </WrapPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="작업지시일자"
                                    Width="110"
                                    Binding="{Binding InstructionDate, StringFormat=yyyy-MM-dd}"/>

                <DataGridTextColumn Header="작업지시번호"
                                    Width="140"
                                    Binding="{Binding InstructionNo}"/>

                <DataGridTextColumn Header="공정"
                                    Width="80"
                                    Binding="{Binding ProcessTypeName}"/>

                <DataGridTextColumn Header="작업구분"
                                    Width="80"
                                    Binding="{Binding WorkTypeName}"/>

                <DataGridTextColumn Header="거래처명"
                                    Width="180"
                                    Binding="{Binding PartnerName}"/>       

                <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCodesText}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="MES 코드" Binding="{Binding MesProductCodesText}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="품목명"
                                    Width="240"
                                    Binding="{Binding ProductNamesText}"/>

                <DataGridTextColumn Header="발주 시트수"
                                    Width="100"
                                    Binding="{Binding SheetQty}"/>

                <DataGridTextColumn Header="완료 시트수"
                                    Width="100"
                                    Binding="{Binding WorkDoneSheetQty}"/>

                <DataGridTextColumn Header="외주가공비"
                                    Width="120"
                                    Binding="{Binding OutsourceProcessingFee, StringFormat=N0}"/>

                <DataGridTextColumn Header="출고일시"
                                    Width="150"
                                    Binding="{Binding ShippedAt, StringFormat=yyyy-MM-dd HH:mm}"/>

                <DataGridTextColumn Header="비고"
                                    Width="*"
                                    Binding="{Binding WorkDoneRemark}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
                Padding="14"
                Margin="0,0,0,12"
                Background="#F9FAFB"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">
            <DockPanel>
                <TextBlock Text="{Binding TotalCount, StringFormat=검색 건수: {0:N0}건}"
                           FontWeight="Bold"
                           FontSize="14"
                           VerticalAlignment="Center"/>

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding TotalOutsourceProcessingFee, StringFormat=외주가공비 합계: {0:N0}}"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="#1D4ED8"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="3"
                Padding="16"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">
            <Grid DataContext="{Binding SelectedItem}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="선택 상세"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding InstructionNo, StringFormat=작업지시번호: {0}}"/>
                    <TextBlock Text="{Binding InstructionDate, StringFormat=작업지시일자: {0:yyyy-MM-dd}}"/>
                    <TextBlock Text="{Binding ProcessTypeName, StringFormat=공정: {0}}"/>
                    <TextBlock Text="{Binding WorkTypeName, StringFormat=작업구분: {0}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding PartnerName, StringFormat=거래처명: {0}}"/>
                    <TextBlock Text="{Binding ProductNamesText, StringFormat=품목명: {0}}"/>
                    <TextBlock Text="{Binding ProductCodesText, StringFormat=품목코드: {0}}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding MesProductCodesText, StringFormat=MES 코드: {0}}" TextWrapping="Wrap" Foreground="#64748B"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding SheetQty, StringFormat=발주 시트수: {0}}"/>
                    <TextBlock Text="{Binding WorkDoneSheetQty, StringFormat=완료 시트수: {0}}"/>
                    <TextBlock Text="{Binding SheetCutCount, StringFormat=시트 컷수: {0}}"/>
                    <TextBlock Text="{Binding OutsourceProcessingFee, StringFormat=외주가공비: {0:N0}}"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="{Binding VendorReceivedAt, StringFormat=입고완료: {0:yyyy-MM-dd HH:mm}}"/>
                    <TextBlock Text="{Binding WorkDoneAt, StringFormat=작업완료: {0:yyyy-MM-dd HH:mm}}"/>
                    <TextBlock Text="{Binding ShippedAt, StringFormat=출고일시: {0:yyyy-MM-dd HH:mm}}"/>
                    <TextBlock Text="{Binding WorkDoneRemark, StringFormat=비고: {0}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="Mes.Wpf.Modules.RoutingTemplates.Views.RoutingTemplateStepPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Mes.Wpf.Core.Controls"
             mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="검색어"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Column="1"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           Text="사용여부"
                           FontWeight="SemiBold"/>

                <ComboBox Grid.Column="4"
                          Height="32"
                          ItemsSource="{Binding UseYnOptions}"
                          SelectedItem="{Binding SelectedUseYn}" />

                <StackPanel Grid.Column="6"
                            Grid.ColumnSpan="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="100"
                            Height="32"
                            Margin="0,0,8,0"
                            Content="조회"
                            Command="{Binding SearchCommand}" />
                    <Button Width="100"
                            Height="32"
                            Content="초기화"
                            Command="{Binding ResetCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="12" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="라우팅 템플릿 목록"
                               FontSize="16"
                               FontWeight="Bold"/>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedTemplate}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="템플릿코드"
                                                Binding="{Binding TemplateCode}"
                                                Width="160"/>
                            <DataGridTextColumn Header="템플릿명"
                                                Binding="{Binding TemplateName}"
                                                Width="*"/>
                            <DataGridCheckBoxColumn Header="사용"
                                                    Binding="{Binding IsActive}"
                                                    Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="라우팅 Step 목록"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding StepItems}"
                                  SelectedItem="{Binding SelectedStep}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="StepID"
                                                    Binding="{Binding RoutingTemplateStepId}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="공정코드"
                                                    Binding="{Binding ProcessCode}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="공정명"
                                                    Binding="{Binding ProcessName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="순서"
                                                    Binding="{Binding StepSeq}"
                                                    Width="70"/>
                                <DataGridCheckBoxColumn Header="사용"
                                                        Binding="{Binding IsActive}"
                                                        Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:PaginationBar Grid.Row="3"
                                                PageText="{Binding ListPageDisplayText}"
                                                PreviousCommand="{Binding ListPreviousPageCommand}"
                                                NextCommand="{Binding ListNextPageCommand}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Padding="16" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Step 등록 / 편집"
                                   FontSize="16"
                                   FontWeight="Bold"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="템플릿"
                                       FontWeight="SemiBold"/>

                            <TextBox Grid.Column="1"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding EditModel.TemplateCode}"
                                     IsReadOnly="True"
                                     Background="#F5F5F5"/>

                            <TextBox Grid.Column="3"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding EditModel.TemplateName}"
                                     IsReadOnly="True"
                                     Background="#F5F5F5"/>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="StepCode"
                                       FontWeight="SemiBold"/>

                            <TextBox Grid.Column="1"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding EditModel.StepCode}"
                                     IsReadOnly="True"
                                     Background="#F5F5F5"/>

                            <TextBlock Grid.Column="2"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#666"
                                       Text="신규 등록 시 자동 생성"/>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="공정"
                                       FontWeight="SemiBold"/>

                            <ComboBox Grid.Column="1"
                                      Height="32"
                                      ItemsSource="{Binding ProcessItems}"
                                      SelectedItem="{Binding SelectedProcess}"
                                      DisplayMemberPath="ProcessCode"/>

                            <TextBox Grid.Column="3"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedProcess.ProcessName}"
                                     IsReadOnly="True"
                                     Background="#F5F5F5"/>
                        </Grid>

                        <Grid Grid.Row="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="순서"
                                       FontWeight="SemiBold"/>

                            <TextBox Grid.Column="1"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding EditModel.Sequence, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Grid.Row="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="사용여부"
                                       FontWeight="SemiBold"/>

                            <CheckBox Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding EditModel.IsActive}"
                                      Content="사용"/>
                        </Grid>

                        <StackPanel Grid.Row="12"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Width="100"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Content="신규"
                                    Command="{Binding NewCommand}" />
                            <Button Width="100"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    Content="저장"
                                    Command="{Binding SaveCommand}" />
                            <Button Width="100"
                                    Height="32"
                                    Content="삭제"
                                    Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="Mes.Wpf.Modules.ProductionDaily.Views.ProductionDailyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mes.Wpf.Core.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="DueSlackTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource DataGridTextElementStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#166534"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DueSlackLevel}" Value="IMMINENT">
                    <Setter Property="Foreground" Value="#C2410C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DueSlackLevel}" Value="URGENT">
                    <Setter Property="Foreground" Value="#B91C1C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CenterTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource DataGridTextElementStyle}"/>

        <Style x:Key="LeftTextStyle"
               TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="거래처" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="180"
                         Text="{Binding PartnerKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,14,0"/>

                <TextBlock Text="품목" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="240"
                         Text="{Binding ProductKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,14,0"/>

                <TextBlock Text="상태" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Width="120"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedValue="{Binding SelectedStatus}"
                          SelectedValuePath="Code"
                          DisplayMemberPath="Name"
                          Margin="0,0,14,0"/>

                <Button Content="조회"
                        Width="78"
                        Height="30"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SearchCommand}"
                        Margin="0,0,8,0"/>

                <Button Content="초기화"
                        Width="78"
                        Height="30"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ResetCommand}"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.TextSecondary}"
                       Text="{Binding TotalCount, StringFormat=총 {0:N0}건}"/>
        </DockPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Items}"
                  Style="{StaticResource DenseDataGridStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="납기"
                                    Binding="{Binding DueDate, StringFormat={}{0:yyyy-MM-dd}}"
                                    Width="112"
                                    ElementStyle="{StaticResource CenterTextStyle}"/>
                <DataGridTextColumn Header="납기여유"
                                    Binding="{Binding DueSlackText}"
                                    Width="92"
                                    ElementStyle="{StaticResource DueSlackTextStyle}"/>
                <DataGridTextColumn Header="거래처"
                                    Binding="{Binding PartnerName}"
                                    Width="180"
                                    ElementStyle="{StaticResource LeftTextStyle}"/>
                <DataGridTextColumn Header="품목"
                                    Binding="{Binding ProductDisplay}"
                                    Width="*"
                                    MinWidth="260"
                                    ElementStyle="{StaticResource LeftTextStyle}"/>
                <DataGridTextColumn Header="발주수량"
                                    Binding="{Binding OrderQty, StringFormat={}{0:N0}}"
                                    Width="100"
                                    ElementStyle="{StaticResource CenterTextStyle}"/>
                <DataGridTextColumn Header="가용재고"
                                    Binding="{Binding AvailableInventoryQty, StringFormat={}{0:N0}}"
                                    Width="100"
                                    ElementStyle="{StaticResource CenterTextStyle}"/>
                <DataGridTextColumn Header="생산수량"
                                    Binding="{Binding ProductionQty, StringFormat={}{0:N0}}"
                                    Width="100"
                                    ElementStyle="{StaticResource CenterTextStyle}"/>
                <DataGridTextColumn Header="작업구분"
                                    Binding="{Binding WorkTypeDisplay}"
                                    Width="94"
                                    ElementStyle="{StaticResource CenterTextStyle}"/>
                <DataGridTextColumn Header="현재공정"
                                    Binding="{Binding CurrentProcessDisplay}"
                                    Width="110"
                                    ElementStyle="{StaticResource CenterTextStyle}"/>
                <DataGridTemplateColumn Header="진행률" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center" Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0"
                                             Height="8"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ProgressRate}"
                                             VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProgressText}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <controls:PaginationBar Grid.Row="0"
                                    PageText="{Binding PageDisplayText}"
                                    PreviousCommand="{Binding PreviousPageCommand}"
                                    NextCommand="{Binding NextPageCommand}"/>
            <ProgressBar Grid.Row="1"
                         Margin="0,6,0,0"
                         Height="3"
                         IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>

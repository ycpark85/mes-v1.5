<UserControl x:Class="Mes.Wpf.Modules.OrderLines.Views.OrderLineBulkImportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Padding="12" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="업로드 파일" />

                <TextBox Grid.Column="1"
                         Margin="8,0,8,0"
                         IsReadOnly="True"
                         Text="{Binding SelectedFilePath}" />

                <Button Grid.Column="2"
                        Width="90"
                        Margin="0,0,8,0"
                        Content="파일선택"
                        Command="{Binding SelectFileCommand}" />

                <Button Grid.Column="3"
                        Width="90"
                        Margin="0,0,8,0"
                        Content="검증"
                        Command="{Binding ValidateCommand}" />

                <Button Grid.Column="4"
                        Width="90"
                        Margin="0,0,8,0"
                        Content="등록"
                        Command="{Binding CommitCommand}" />

                <Button Grid.Column="5"
                        Width="90"
                        Content="초기화"
                        Command="{Binding ResetCommand}" />

                <Button Grid.Column="6"
                        Content="선택 행 삭제"
                        Command="{Binding RemoveSelectedRowCommand}"
                        Padding="12,6"
                        Margin="8,0,0,0" />

                <Button Grid.Column="7"
                        Content="오류 행 전체 삭제"
                        Command="{Binding RemoveErrorRowsCommand}"
                        Padding="12,6"
                        Margin="8,0,0,0" /> 
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Padding="12"
                BorderBrush="#DDD"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
            <UniformGrid Rows="1" Columns="4">
                <StackPanel>
                    <TextBlock Text="총 행수" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalRowCount}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="정상" FontWeight="Bold" />
                    <TextBlock Text="{Binding ReadyRowCount}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="검토필요" FontWeight="Bold" />
                    <TextBlock Text="{Binding ReviewRowCount}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="오류" FontWeight="Bold" />
                    <TextBlock Text="{Binding ErrorRowCount}" />
                </StackPanel>
            </UniformGrid>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="발주파일의 품목명·규격으로 저장합니다. 'MES 기준 품목명도 변경'을 체크한 행만 기준 품목명도 변경하며, 기존 발주 품명과 MES 기준 규격은 유지합니다." />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding FlatRows}"
                  SelectedItem="{Binding SelectedValidationRow, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn IsReadOnly="True" Header="행번호" Binding="{Binding RowNumber}" Width="70" />
                <DataGridTextColumn IsReadOnly="True" Header="ERP주문번호" Binding="{Binding ErpOrderNo}" Width="140" />
                <DataGridTextColumn IsReadOnly="True" Header="거래처" Binding="{Binding PartnerName}" Width="120"/>
                <DataGridTextColumn IsReadOnly="True" Header="품목코드" Binding="{Binding ProductCode}" Width="120" />
                <DataGridTextColumn IsReadOnly="True" Header="발주 품목명[규격]" Binding="{Binding ErpProductDisplayName}" Width="220" />
                <DataGridTextColumn IsReadOnly="True" Header="MES 기준 품목명[규격]" Binding="{Binding MesProductDisplayName}" Width="220" />
                <DataGridTemplateColumn Header="MES 기준 품목명도 변경" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding ApplyProductNameChange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanApplyProductNameChange}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      AutomationProperties.Name="MES 기준 품목명도 변경"
                                      ToolTip="체크하지 않아도 발주파일 품목명으로 등록됩니다. 체크하면 공통 MES 기준 품목명도 변경합니다. 규격은 변경하지 않습니다." />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn IsReadOnly="True" Header="MES 코드" Binding="{Binding MesProductCode}" Width="130"/>
                <DataGridTextColumn IsReadOnly="True" Header="연결 도면" Binding="{Binding DrawingNo}" Width="120"/>
                <DataGridTextColumn IsReadOnly="True" Header="수량" Binding="{Binding OrderQty}" Width="90" />
                <DataGridTextColumn IsReadOnly="True" Header="상태" Binding="{Binding Status}" Width="90" />
                <DataGridTextColumn IsReadOnly="True" Header="메시지" Binding="{Binding MessageSummary}" Width="300" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.RowSpan="3"
      Background="#80000000"
      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
      Panel.ZIndex="999">
            <Border Width="220"
            Height="120"
            Background="White"
            CornerRadius="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    <ProgressBar Width="160"
                         Height="18"
                         IsIndeterminate="True" />
                    <TextBlock Margin="0,12,0,0"
                       HorizontalAlignment="Center"
                       Text="처리 중입니다..." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

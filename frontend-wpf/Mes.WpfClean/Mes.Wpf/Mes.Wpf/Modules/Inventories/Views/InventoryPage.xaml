<UserControl x:Class="Mes.Wpf.Modules.Inventories.Views.InventoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mes.Wpf.Core.Controls">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="검색" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="240"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0"/>
                <Button Content="조회"
                        Width="80"
                        Command="{Binding SearchCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="초기화"
                        Width="80"
                        Command="{Binding ResetCommand}"/>
                <Button Content="기초재고등록"
                        Width="110"
                        Command="{Binding OpenInitialInventoryBulkUploadCommand}"
                        Margin="8,0,0,0"/>
                <Button Content="정합성점검"
                        Width="100"
                        Command="{Binding CheckConsistencyCommand}"
                        Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCode}" Width="140"/>
                <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="단위" Binding="{Binding Uom}" Width="80"/>
                <DataGridTextColumn Header="현재고" Binding="{Binding CurrentQty}" Width="120"/>
                <DataGridTextColumn Header="수정일시" Binding="{Binding UpdatedAt}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <controls:PaginationBar Grid.Row="1"
                                PageText="{Binding ListPageDisplayText}"
                                PreviousCommand="{Binding ListPreviousPageCommand}"
                                NextCommand="{Binding ListNextPageCommand}"/>
        </Grid>

        <Border Grid.Row="2" Margin="0,12,0,12" Padding="12" BorderBrush="#DDD" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{Binding EditModel.ProductName}"/>

                <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Text="조정 LOT"
                   Margin="12,0,8,0"/>

                <TextBox Grid.Column="2"
                 Width="130"
                 Text="{Binding AdjustmentLotNo, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="3"
                   VerticalAlignment="Center"
                   Text="조정수량"
                   Margin="16,0,8,0"/>

                <TextBox Grid.Column="4"
                 Width="90"
                 Text="{Binding AdjustmentQty, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="5"
                   VerticalAlignment="Center"
                   Text="비고"
                   Margin="16,0,8,0"/>

                <TextBox Grid.Column="6"
                 Margin="0,0,8,0"
                 Text="{Binding AdjustmentMemo, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Column="7"
                Content="재고증가"
                Width="90"
                Command="{Binding AdjustInCommand}"
                Margin="0,0,8,0"/>

                <Button Grid.Column="8"
                Content="재고감소"
                Width="90"
                Command="{Binding AdjustOutCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="재고 이력" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox Width="160"
                          ItemsSource="{Binding MovementTypeOptions}"
                          SelectedItem="{Binding SelectedMovementType}"/>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Movements}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="일시" Binding="{Binding CreatedAt}" Width="180"/>
                    <DataGridTemplateColumn Header="구분" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding MovementType}"/>
                                            <Setter Property="Foreground" Value="#333333"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MovementType}" Value="INITIAL_STOCK">
                                                    <Setter Property="Text" Value="기초재고"/>
                                                    <Setter Property="Foreground" Value="#1F5FBF"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding MovementType}" Value="INSPECTION_IN">
                                                    <Setter Property="Text" Value="검수입고"/>
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding MovementType}" Value="SHIP_OUT">
                                                    <Setter Property="Text" Value="출고"/>
                                                    <Setter Property="Foreground" Value="#C76300"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding MovementType}" Value="ADJUST_IN">
                                                    <Setter Property="Text" Value="재고증가"/>
                                                    <Setter Property="Foreground" Value="#1F5FBF"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding MovementType}" Value="ADJUST_OUT">
                                                    <Setter Property="Text" Value="재고감소"/>
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="재고 LOT" Binding="{Binding StockLotNo}" Width="130"/>
                    <DataGridTextColumn Header="수량" Binding="{Binding Qty}" Width="100"/>
                    <DataGridTextColumn Header="반영 후 재고" Binding="{Binding BalanceAfter}" Width="120"/>
                    <DataGridTextColumn Header="수주ID" Binding="{Binding OrderLineId}" Width="100"/>
                    <DataGridTextColumn Header="검수결과ID" Binding="{Binding InspectionResultId}" Width="120"/>
                    <DataGridTextColumn Header="비고" Binding="{Binding Memo}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="Mes.Wpf.Modules.Inventories.Views.InventoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Mes.Wpf.Core.Controls">
    <UserControl.Resources>
        <Style x:Key="InventoryHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource CrudDataGridColumnHeaderStyle}">
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style x:Key="InventoryCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource CrudDataGridCellStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="InventoryCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DataGridTextElementStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource CrudDataGridStyle}">
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource InventoryHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource InventoryCellStyle}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="MinRowHeight" Value="32"/>
        </Style>
        <Style x:Key="InventorySection" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7DFE9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="130"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="4*" MinHeight="330"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <Menu DockPanel.Dock="Right" VerticalAlignment="Center" Background="Transparent">
                <MenuItem Header="관리기능">
                    <MenuItem Header="기초재고등록" Command="{Binding OpenInitialInventoryBulkUploadCommand}"/>
                    <MenuItem Header="재고 정합성 점검" Command="{Binding CheckConsistencyCommand}"/>
                </MenuItem>
            </Menu>
            <WrapPanel>
                <TextBlock Text="품목 검색" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="260" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="품목코드 또는 품목명" ToolTip="품목코드 또는 품목명"
                         Margin="0,0,8,0">
                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
                </TextBox>
                <CheckBox Content="재고 0 포함" IsChecked="{Binding IncludeZeroStock}" VerticalAlignment="Center"
                          ToolTip="품목·LOT 조회 시 재고가 0인 항목도 포함합니다." Margin="4,0,16,0"/>
                <Button Content="조회" Width="72" Command="{Binding SearchCommand}" Margin="0,0,8,0"/>
                <Button Content="초기화" Width="72" Command="{Binding ResetCommand}"/>
            </WrapPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutomationProperties.Name="품목별 재고현황">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCode}" Width="140" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="*" MinWidth="180" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="현재 재고수량" Binding="{Binding CurrentQty, StringFormat=N0}" Width="130" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="단위" Binding="{Binding Uom}" Width="60" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                    <DataGridTextColumn Header="최종수정일시" Binding="{Binding LocalUpdatedAt, StringFormat=yyyy-MM-dd HH:mm:ss, TargetNullValue=—}" Width="180" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#475569" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value=""/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0"><Setter Property="Text" Value="조회된 품목이 없습니다. 검색어와 재고 0 포함 여부를 확인하세요."/></DataTrigger>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Text" Value="재고를 조회하고 있습니다…"/><Setter Property="Background" Value="White"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <controls:PaginationBar Grid.Row="1" PageText="{Binding ListPageDisplayText}"
                                    PreviousCommand="{Binding ListPreviousPageCommand}" NextCommand="{Binding ListNextPageCommand}"/>
        </Grid>
        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#E2E8F0"/>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding SelectedProductText}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="340"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="3*" MinWidth="500"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource InventorySection}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="재고조정" Command="{Binding OpenAdjustmentCommand}" Padding="10,5" Margin="0,0,6,0"/>
                                <Button Content="상세보기" Command="{Binding OpenHistoryCommand}" Padding="12,5"
                                        ToolTip="선택한 LOT의 입·출고 이력을 오른쪽에 표시합니다."/>
                            </StackPanel>
                            <TextBlock Text="재고현황" FontSize="16" FontWeight="SemiBold" Foreground="#1E3A5F" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="LOT 검색" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding LotKeyword, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="LOT 번호 검색" Margin="0,0,8,0">
                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding LoadLotsCommand}"/></TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="2" Content="조회" Command="{Binding LoadLotsCommand}" Width="56"/>
                        </Grid>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Lots}" SelectedItem="{Binding SelectedLot, Mode=TwoWay}" AutomationProperties.Name="LOT별 현재 재고">
                            <DataGrid.InputBindings><KeyBinding Key="Enter" Command="{Binding OpenHistoryCommand}"/></DataGrid.InputBindings>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="LOT 번호" Binding="{Binding LotNo}" Width="*" MinWidth="115" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                                <DataGridTextColumn Header="재고수량" Binding="{Binding CurrentQty, StringFormat=N0}" Width="100" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                                <DataGridTemplateColumn Header="최종수정일시" Width="120" SortMemberPath="LocalUpdatedAt">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LocalUpdatedAt, StringFormat=yyyy-MM-dd, TargetNullValue=—}" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding LocalUpdatedAt, StringFormat=HH:mm:ss}" TextAlignment="Center" Foreground="#64748B" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <TextBlock Text="{Binding LotSummaryText}" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock Text="{Binding LotStatus}" TextWrapping="Wrap" Foreground="#475569" Margin="0,4,0,0" FontSize="12"/>
                        </StackPanel>
                        <controls:PaginationBar Grid.Row="4" PageText="{Binding LotPageText}" PreviousCommand="{Binding LotPreviousCommand}" NextCommand="{Binding LotNextCommand}"/>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#E2E8F0"
                              AutomationProperties.Name="재고현황과 이력의 너비 조절"/>
                <Border Grid.Column="2" Style="{StaticResource InventorySection}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="재고이력관리" FontSize="16" FontWeight="SemiBold" Foreground="#1E3A5F" Margin="0,4,0,12"/>
                        <TextBlock Grid.Row="1" Text="{Binding SelectedLotText}" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <WrapPanel Grid.Row="2" Margin="0,0,0,10" IsEnabled="{Binding IsHistoryOpen}">
                            <TextBlock Text="기간" VerticalAlignment="Center" Margin="0,0,6,4"/>
                            <DatePicker SelectedDate="{Binding DateFrom}" Width="115" AutomationProperties.Name="이력 시작일" Margin="0,0,0,4"/>
                            <TextBlock Text=" ~ " VerticalAlignment="Center" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding DateTo}" Width="115" AutomationProperties.Name="이력 종료일" Margin="0,0,0,4"/>
                            <Button Content="전체기간" Command="{Binding ClearHistoryPeriodCommand}" Padding="8,4" Margin="6,0,10,4"/>
                            <TextBlock Text="구분" VerticalAlignment="Center" Margin="0,0,6,4"/>
                            <ComboBox Width="90" ItemsSource="{Binding MovementTypeOptions}" SelectedItem="{Binding SelectedMovementType}" AutomationProperties.Name="이력 구분" Margin="0,0,0,4"/>
                            <Button Content="조회" Command="{Binding SearchHistoryCommand}" Width="56" Margin="6,0,0,4"/>
                        </WrapPanel>
                        <DataGrid Grid.Row="3" ItemsSource="{Binding Movements}" CanUserSortColumns="False" AutomationProperties.Name="선택한 LOT 입출고 이력">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="일시 (한국시간)" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LocalCreatedAt, StringFormat=yyyy-MM-dd}" TextAlignment="Center"/>
                                                <TextBlock Text="{Binding LocalCreatedAt, StringFormat=HH:mm:ss}" TextAlignment="Center" Foreground="#64748B" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="구분" Binding="{Binding MovementLabel}" Width="66" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                                <DataGridTextColumn Header="입고수량" Binding="{Binding InQty, StringFormat=N0, TargetNullValue=—}" Width="75" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                                <DataGridTextColumn Header="출고수량" Binding="{Binding OutQty, StringFormat=N0, TargetNullValue=—}" Width="75" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                                <DataGridTextColumn Header="처리 후 재고" Binding="{Binding LotBalanceAfter, StringFormat=N0, TargetNullValue=확인불가}" Width="90" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                                <DataGridTextColumn Header="관련 업무" Binding="{Binding ReferenceLabel}" Width="80" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                                <DataGridTextColumn Header="비고" Binding="{Binding Memo}" Width="*" MinWidth="95" ElementStyle="{StaticResource InventoryCellTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="4" Text="{Binding HistoryStatus}" TextWrapping="Wrap" Foreground="#475569" Margin="0,8,0,0" FontSize="12"/>
                        <controls:PaginationBar Grid.Row="5" PageText="{Binding HistoryPageText}" PreviousCommand="{Binding HistoryPreviousCommand}" NextCommand="{Binding HistoryNextCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="Mes.Wpf.Modules.Drawings.Views.DrawingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Mes.Wpf.Core.Controls"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="CenterCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="78"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="WideActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="118"/>
        </Style>

        <Style x:Key="FileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="66"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="CenterTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="LeftTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Padding" Value="8,0,8,0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF2F7"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0,4,0"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16" Background="#F5F7FB">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 검색 영역 -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource LabelTextStyle}"
                           Text="검색어"/>

                <TextBox Grid.Column="1"
                         Height="32"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="3"
                           Style="{StaticResource LabelTextStyle}"
                           Text="사용여부"/>

                <ComboBox Grid.Column="4"
                          Height="32"
                          ItemsSource="{Binding UseYnOptions}"
                          SelectedItem="{Binding SelectedUseYn}" />

                <Button Grid.Column="6"
                        Height="32"
                        Content="조회"
                        Command="{Binding SearchCommand}" />

                <Button Grid.Column="8"
                        Height="32"
                        Content="초기화"
                        Command="{Binding ResetCommand}" />
            </Grid>
        </Border>

        <!-- 본문 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측 도면 목록 -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="도면 목록"/>

                    <DataGrid Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              GridLinesVisibility="Horizontal"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="도면번호"
                                                Width="130"
                                                Binding="{Binding DrawingNo}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterTextBlockStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="현재 Rev No"
                                                Width="70"
                                                Binding="{Binding CurrentRevisionNo}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterTextBlockStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridCheckBoxColumn Header="사용"
                                                    Width="70"
                                                    Binding="{Binding IsActive}" 
                                                    ElementStyle="{StaticResource CenterCheckBoxStyle}"/>

                            <DataGridTextColumn Header="등록일"
                                                Width="110"
                                                Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterTextBlockStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="수정일"
                                                Width="110"
                                                Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterTextBlockStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <controls:PaginationBar Grid.Row="3"
                                            PageText="{Binding ListPageDisplayText}"
                                            PreviousCommand="{Binding ListPreviousPageCommand}"
                                            NextCommand="{Binding ListNextPageCommand}"/>
                </Grid>
            </Border>

            <!-- 우측 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="1.15*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="0.9*"/>
                </Grid.RowDefinitions>

                <!-- 도면 기본정보 -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="4"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="도면 기본정보"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Style="{StaticResource LabelTextStyle}"
                                   Text="도면번호"/>

                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 IsEnabled="{Binding IsCodeEditable}"
                                 Text="{Binding EditModel.DrawingNo, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Grid.Row="2"
                                  Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Content="사용"
                                  IsEnabled="{Binding IsCodeEditable}"
                                  IsChecked="{Binding EditModel.IsActive}"
                                  Margin="12,0,0,0" />

                        <StackPanel Grid.Row="4"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Content="신규"
                                    Command="{Binding NewCommand}" />

                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Content="수정"
                                    Command="{Binding EditCommand}" />

                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Content="저장"
                                    Command="{Binding SaveCommand}" />

                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Margin="0"
                                    Content="삭제"
                                    Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 리비전 등록/선택 -->
                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}"
                        IsEnabled="{Binding IsRevisionSectionEnabled}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="리비전 등록/선택"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="132"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource LabelTextStyle}"
                                       Text="Rev No"/>

                            <TextBox Grid.Column="1"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding RevisionEditModel.RevNo, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Grid.Column="3"
                                    Style="{StaticResource WideActionButtonStyle}"
                                    Content="신규 리비전"
                                    Command="{Binding NewRevisionCommand}" />

                            <Button Grid.Column="5"
                                    Style="{StaticResource WideActionButtonStyle}"
                                    Content="리비전 저장"
                                    Command="{Binding SaveRevisionBundleCommand}" />

                            <Button Grid.Column="7"
                                    Width="132"
                                    Height="32"
                                    Margin="0"
                                    Content="현재 리비전 지정"
                                    Command="{Binding SetCurrentRevisionCommand}" />
                        </Grid>

                        <DataGrid Grid.Row="4"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding RevisionItems}"
                                  SelectedItem="{Binding SelectedRevision, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rev No"
                                                    Width="120"
                                                    Binding="{Binding RevNo}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterTextBlockStyle}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="파일수"
                                                    Width="90"
                                                    Binding="{Binding Files.Count}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterTextBlockStyle}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="등록일시"
                                                    Width="150"
                                                    Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterTextBlockStyle}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="등록자"
                                                    Width="120"
                                                    Binding="{Binding CreatedBy}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CenterTextBlockStyle}"/>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 리비전 파일 -->
                <Border Grid.Row="4"
                        Style="{StaticResource CardBorderStyle}"
                        IsEnabled="{Binding CanCreateRevision}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="5"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Text="리비전 파일"/>

                        <!-- 도면파일 -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Style="{StaticResource LabelTextStyle}"
                                   Text="도면파일"/>

                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Height="32"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding DrawingDisplayFileName, Mode=OneWay}" />

                        <Button Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource FileButtonStyle}"
                                Content="선택"
                                Command="{Binding BrowseDrawingFileCommand}" />

                        <Button Grid.Row="2"
                                Grid.Column="3"
                                Style="{StaticResource FileButtonStyle}"
                                Content="열기"
                                Command="{Binding OpenDrawingFileCommand}" />

                        <!-- 원본파일 -->
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Style="{StaticResource LabelTextStyle}"
                                   Text="원본파일"/>

                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Height="32"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding OriginalDisplayFileName, Mode=OneWay}" />

                        <Button Grid.Row="4"
                                Grid.Column="2"
                                Style="{StaticResource FileButtonStyle}"
                                Content="선택"
                                Command="{Binding BrowseOriginalFileCommand}" />

                        <Button Grid.Row="4"
                                Grid.Column="3"
                                Style="{StaticResource FileButtonStyle}"
                                Content="열기"
                                Command="{Binding OpenOriginalFileCommand}" />

                        <!-- 판작업파일 -->
                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   Style="{StaticResource LabelTextStyle}"
                                   Text="판작업파일"/>

                        <TextBox Grid.Row="6"
                                 Grid.Column="1"
                                 Height="32"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding PlateDisplayFileName, Mode=OneWay}" />

                        <Button Grid.Row="6"
                                Grid.Column="2"
                                Style="{StaticResource FileButtonStyle}"
                                Content="선택"
                                Command="{Binding BrowsePlateFileCommand}" />

                        <Button Grid.Row="6"
                                Grid.Column="3"
                                Style="{StaticResource FileButtonStyle}"
                                Content="열기"
                                Command="{Binding OpenPlateFileCommand}" />

                        <Button Grid.Row="8"
                                Grid.Column="1"
                                Width="130"
                                Height="32"
                                HorizontalAlignment="Left"
                                Content="파일 변경 저장"
                                Command="{Binding SaveChangedFilesCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 로딩 -->
        <Border Grid.RowSpan="3"
                Background="#66000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                d:Visibility="Collapsed">
            <Border Width="280"
                    Padding="24"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar Height="16"
                                 IsIndeterminate="True"/>
                    <TextBlock Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Text="{Binding LoadingMessage}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

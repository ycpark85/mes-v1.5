<Window x:Class="Mes.Wpf.Modules.Auth.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="세미산업 코팅타이벡 MES 프로그램"
        Width="1120"
        Height="700"
        MinWidth="1120"
        MinHeight="700"
        MaxWidth="1120"
        MaxHeight="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#E5E7EB">

    <Window.Resources>
        <LinearGradientBrush x:Key="LeftPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#061A38" Offset="0" />
            <GradientStop Color="#0B2D5C" Offset="0.55" />
            <GradientStop Color="#0F4C81" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="12"
                        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="#94A3B8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Background="White"
            CornerRadius="16"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#111827"
                              Opacity="0.20"
                              BlurRadius="20"
                              ShadowDepth="5" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="590" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 왼쪽 브랜딩 영역 -->
                <Border Grid.Column="0"
                        Background="{StaticResource LeftPanelBrush}"
                        CornerRadius="16,0,0,0"
                        Padding="42,34,36,24"
                        ClipToBounds="True">

                    <Grid>
                        <Ellipse Width="260"
                                 Height="260"
                                 Fill="#1D4ED8"
                                 Opacity="0.12"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,-90,-90" />

                        <Ellipse Width="170"
                                 Height="170"
                                 Stroke="#93C5FD"
                                 StrokeThickness="1"
                                 Opacity="0.18"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,70,35,0" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58" />
                                <RowDefinition Height="240" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 브랜드 -->
                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Top">
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="13"
                                        Background="#2563EB">
                                    <Grid>
                                        <Polygon Points="24,8 39,17 39,32 24,41 9,32 9,17"
                                                 Fill="#DBEAFE" />
                                        <Polygon Points="9,17 24,25 24,41 9,32"
                                                 Fill="#60A5FA" />
                                        <Polygon Points="39,17 24,25 24,41 39,32"
                                                 Fill="#1D4ED8" />
                                    </Grid>
                                </Border>

                                <StackPanel Margin="13,3,0,0">
                                    <TextBlock Text="SEMI INDUSTRY"
                                               Foreground="White"
                                               FontSize="17"
                                               FontWeight="Bold" />
                                    <TextBlock Text="COATING TYVEK"
                                               Foreground="#BFDBFE"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>

                            <!-- 핵심 문구 -->
                            <StackPanel Grid.Row="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="세미산업"
                                           Foreground="White"
                                           FontSize="30"
                                           FontWeight="Bold" />

                                <TextBlock Text="코팅타이벡"
                                           Foreground="#60A5FA"
                                           FontSize="38"
                                           FontWeight="Bold"
                                           Margin="0,0,0,0" />

                                <TextBlock Text="MES 프로그램"
                                           Foreground="White"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Margin="0,2,0,0" />

                                <Border Width="52"
                                        Height="4"
                                        CornerRadius="2"
                                        Background="#3B82F6"
                                        HorizontalAlignment="Left"
                                        Margin="0,16,0,0" />

                                <TextBlock Text="생산관리, 공정추적, 검수 및 출하 흐름을&#x0a;통합 관리하는 스마트 MES 시스템"
                                           Foreground="#E0F2FE"
                                           FontSize="15"
                                           LineHeight="24"
                                           TextWrapping="Wrap"
                                           Margin="0,16,0,0" />
                            </StackPanel>

                            <!-- 기능 요약 -->
                            <StackPanel Grid.Row="2"
                                        VerticalAlignment="Top"
                                        Margin="0,8,0,0">

                                <Grid Height="38" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="34"
                                            Height="34"
                                            CornerRadius="17"
                                            Background="#1D4ED8">
                                        <TextBlock Text="▥"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="실시간 생산 현황 관리"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Grid Height="38" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="34"
                                            Height="34"
                                            CornerRadius="17"
                                            Background="#1D4ED8">
                                        <TextBlock Text="⌕"
                                                   Foreground="White"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="공정 · LOT 추적"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Grid Height="38">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="34"
                                            Height="34"
                                            CornerRadius="17"
                                            Background="#1D4ED8">
                                        <TextBlock Text="□"
                                                   Foreground="White"
                                                   FontSize="17"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="검수 및 출하 이력 통합"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 오른쪽 로그인 영역 -->
                <Border Grid.Column="1"
                        Background="#F8FAFC"
                        CornerRadius="0,16,0,0">    

                    <Grid>
                        <Border Width="382"
                                Height="528"
                                Background="White"
                                CornerRadius="20"
                                Padding="34,28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,44,0,0">      
                            <Border.Effect>
                                <DropShadowEffect Color="#64748B"
                                  Opacity="0.18"
                                  BlurRadius="24"
                                  ShadowDepth="5" />
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 상단 아이콘 -->
                                <Border Grid.Row="0"
                                        Width="54"
                                        Height="54"
                                        CornerRadius="27"
                                        Background="#EFF6FF"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,14">  
                                    <Viewbox Width="24"
                                             Height="24">
                                        <Grid Width="24" Height="24">
                                            <Path Stroke="#2563EB"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"
                                                  Data="M7,11 L7,8 C7,5.2 9.2,3 12,3 C14.8,3 17,5.2 17,8 L17,11" /> 
                                            <Path Stroke="#2563EB"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent"
                                                  Data="M6,11 L18,11 L18,20 L6,20 Z" />     
                                            <Path Stroke="#2563EB"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Data="M12,15 L12,17" />   
                                        </Grid>
                                    </Viewbox>
                                </Border>

                                <TextBlock Grid.Row="1"
                                           Text="로그인"
                                           Foreground="#0F172A"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />  

                                <TextBlock Grid.Row="2"
                                           Text="세미산업 코팅타이벡 MES에 접속합니다"
                                           Foreground="#64748B"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,20" /> 

                                <Border Grid.Row="3"
                                        Height="1"
                                        Background="#E2E8F0"
                                        Margin="0,0,0,20" />        

                                <!-- 아이디 -->
                                <StackPanel Grid.Row="4"
                                            Margin="0,0,0,14">  
                                    <TextBlock Text="아이디"
                                               Foreground="#1E293B"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Margin="0,0,0,7" />  

                                    <Border Height="44"
                                            Background="#FFFFFF"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="10">      
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Viewbox Width="17"
                                                     Height="17"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">    
                                                <Grid Width="24" Height="24">   
                                                    <Path Stroke="#94A3B8"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Fill="Transparent"
                                                          Data="M12,12 C14.2,12 16,10.2 16,8 C16,5.8 14.2,4 12,4 C9.8,4 8,5.8 8,8 C8,10.2 9.8,12 12,12 Z" />    
                                                    <Path Stroke="#94A3B8"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Fill="Transparent"
                                                          Data="M5,20 C5.8,16.7 8.5,15 12,15 C15.5,15 18.2,16.7 19,20" />   
                                                </Grid>
                                            </Viewbox>

                                            <TextBox x:Name="LoginIdTextBox"
                                                     Grid.Column="1"
                                                     Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource LoginTextBoxStyle}"
                                                     TabIndex="0" />    
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- 비밀번호 -->
                                <StackPanel Grid.Row="5"
                                            Margin="0,0,0,8">   
                                    <TextBlock Text="비밀번호"
                                               Foreground="#1E293B"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Margin="0,0,0,7" />  

                                    <Border Height="44"
                                            Background="#FFFFFF"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="10">  
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Viewbox Width="17"
                                                     Height="17"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">    
                                                <Grid Width="24" Height="24">
                                                    <Path Stroke="#94A3B8"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Fill="Transparent"
                                                          Data="M7,11 L7,8 C7,5.2 9.2,3 12,3 C14.8,3 17,5.2 17,8 L17,11" /> 
                                                    <Path Stroke="#94A3B8"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          Fill="Transparent"
                                                          Data="M6,11 L18,11 L18,20 L6,20 Z" /> 
                                                </Grid>
                                            </Viewbox>

                                            <PasswordBox x:Name="PasswordBox"
                                                         Grid.Column="1"
                                                         Style="{StaticResource LoginPasswordBoxStyle}"
                                                         TabIndex="1"
                                                         KeyDown="PasswordBox_KeyDown" />   
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <CheckBox Grid.Row="6"
                                          Content="ID 저장"
                                          IsChecked="{Binding RememberLoginId, Mode=TwoWay}"
                                          Foreground="#475569"
                                          FontSize="12"
                                          VerticalContentAlignment="Center"
                                          TabIndex="2"
                                          Margin="0,0,0,10" />

                                <TextBlock Grid.Row="7"
                                           Text="{Binding ErrorMessage}"
                                           Foreground="#DC2626"
                                           FontSize="12"
                                           Height="22"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,12" /> 

                                <!-- 로그인 버튼 -->
                                <Button Grid.Row="8"
                                        Content="로그인"
                                        Style="{StaticResource LoginButtonStyle}"
                                        TabIndex="3"
                                        Click="LoginButton_Click" />

                                <TextBlock Grid.Row="9"
                                           Text="권한 기반 MES 접속"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           Margin="0,12,0,0" /> 
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 하단 푸터 -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="0,0,16,16"
                    BorderBrush="#E5E7EB"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Semi Industry Coating Tyvek MES"
                               Foreground="#64748B"
                               FontSize="12"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding RuntimeDescription}"
                               ToolTip="{Binding RuntimeDetails}"
                               Foreground="#94A3B8"
                               FontSize="9"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

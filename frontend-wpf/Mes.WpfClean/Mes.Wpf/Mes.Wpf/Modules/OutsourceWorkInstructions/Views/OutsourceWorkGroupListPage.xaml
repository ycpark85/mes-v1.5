<UserControl x:Class="Mes.Wpf.Modules.OutsourceWorkInstructions.Views.OutsourceWorkGroupListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1400">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="#D1D5DB"
                BorderThickness="1"
                Padding="14"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="시작일" VerticalAlignment="Center" />
                <DatePicker Grid.Column="1" SelectedDate="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" Text="종료일" VerticalAlignment="Center" />
                <DatePicker Grid.Column="3" SelectedDate="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="4" Text="공정" VerticalAlignment="Center" />
                <ComboBox Grid.Column="5" ItemsSource="{Binding ProcessTypeOptions}" SelectedItem="{Binding SelectedProcessType}" />
                <TextBlock Grid.Column="6" Text="상태" VerticalAlignment="Center" />
                <ComboBox Grid.Column="7" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" />
                <TextBlock Grid.Column="8" Text="검색어" VerticalAlignment="Center" />
                <TextBox Grid.Column="9" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="11" Content="조회" Command="{Binding SearchCommand}" />
                <Button Grid.Column="13" Content="초기화" Command="{Binding ResetCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    Background="White"
                    Padding="8">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          RowHeight="34"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="작업일" Binding="{Binding InstructionDate, StringFormat=yyyy-MM-dd}" Width="90" IsReadOnly="True" />
                        <DataGridTextColumn Header="지시번호" Binding="{Binding InstructionNo}" Width="145" IsReadOnly="True" />
                        <DataGridTextColumn Header="그룹" Binding="{Binding GroupSeq}" Width="70" IsReadOnly="True" />
                        <DataGridTextColumn Header="공정" Binding="{Binding ProcessType}" Width="60" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="상태" Width="80" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusName}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#374151" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="REGISTERED">
                                                        <Setter Property="Foreground" Value="#2563EB" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="VENDOR_RECEIVED">
                                                        <Setter Property="Foreground" Value="#9333EA" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="WORK_DONE">
                                                        <Setter Property="Foreground" Value="#16A34A" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="SHIPPED">
                                                        <Setter Property="Foreground" Value="#0F766E" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="CANCELED">
                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="거래처" Binding="{Binding PartnerName}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="구분" Binding="{Binding BundleText}" Width="60" IsReadOnly="True" />
                        <DataGridTextColumn Header="LOT" Binding="{Binding LotNosText}" Width="180" IsReadOnly="True" />
                        <DataGridTextColumn Header="대표품목" Binding="{Binding RepresentativeProductName}" Width="160" IsReadOnly="True" />
                        <DataGridTextColumn Header="사용M" Binding="{Binding LengthM, StringFormat={}{0:N2}}" Width="80" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    Background="White"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedDetail.InstructionNo}" FontWeight="Bold" FontSize="18" />
                            <TextBlock Text="{Binding SelectedDetail.StatusName}" Foreground="#374151" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Height="32"
                                Content="작업지시 취소"
                                Command="{Binding CancelCommand}" />
                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="취소사유" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Height="28"
                                     Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="거래처" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedDetail.PartnerName}" />
                        <TextBlock Grid.Column="2" Text="원단LOT" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="{Binding SelectedDetail.FabricLotNo}" />
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="작업 LOT" FontWeight="SemiBold" />
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding SelectedDetail.Lots}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  RowHeaderWidth="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="110" IsReadOnly="True" />
                                <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="170" IsReadOnly="True" />
                                <DataGridTextColumn Header="수량" Binding="{Binding LotQty, StringFormat={}{0:N0}}" Width="70" IsReadOnly="True" />
                                <DataGridTextColumn Header="컷수" Binding="{Binding CutsPerSheet}" Width="60" IsReadOnly="True" />
                                <DataGridTextColumn Header="예상수량" Binding="{Binding ExpectedOutputQty, StringFormat={}{0:N0}}" Width="80" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Border Grid.Row="6"
                            IsEnabled="{Binding CanUpdateSelectedDetail}"
                            BorderBrush="#E5E7EB"
                            BorderThickness="0,1,0,0"
                            Padding="0,10,0,0">
                        <StackPanel>
                        <TextBlock Text="수정"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="사용M" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Height="26"
                                     Text="{Binding EditLengthM, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}, TargetNullValue=''}" />
                            <TextBlock Grid.Column="2" Text="매수" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBox Grid.Column="3"
                                     Height="26"
                                     Text="{Binding EditSheetQty, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="4" Text="컷수" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBox Grid.Column="5"
                                     Height="26"
                                     Text="{Binding EditSheetCutCount, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="원단LOT" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Height="26"
                                     Text="{Binding EditFabricLotNo, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="4"
                                    Height="26"
                                    Content="되돌림"
                                    Command="{Binding ReloadEditFormCommand}" />
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="메모" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Height="26"
                                     Text="{Binding EditMemo, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="수정사유" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Height="26"
                                     Text="{Binding UpdateReason, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="3"
                                    Height="26"
                                    Content="수정 저장"
                                    Command="{Binding SaveUpdateCommand}" />
                        </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="취소사유" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

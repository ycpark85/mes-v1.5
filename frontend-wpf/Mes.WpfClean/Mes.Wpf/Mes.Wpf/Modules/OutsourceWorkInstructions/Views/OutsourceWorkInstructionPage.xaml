<UserControl x:Class="Mes.Wpf.Modules.OutsourceWorkInstructions.Views.OutsourceWorkInstructionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽 영역 그대로 유지 -->
            <GroupBox Grid.Column="0" Header="후보 LOT 목록">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Bottom"
                            Height="32"
                            Margin="0,8,0,0"
                            Content="작업지시 추가"
                            Command="{Binding AddDraftCommand}" />

                    <DataGrid ItemsSource="{Binding CandidateLots}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              SelectionMode="Extended">     
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="선택" Width="55">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Focusable="False" />      
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="LOT"
                                                Binding="{Binding LotNo}"
                                                Width="120"
                                                IsReadOnly="True" />        

                            <DataGridTextColumn Header="거래처"
                                                Binding="{Binding CustomerPartnerName}"
                                                Width="140"
                                                IsReadOnly="True" />    

                            <DataGridTextColumn Header="품목코드"
                                                Binding="{Binding ProductCode}"
                                                Width="110"
                                                IsReadOnly="True" />    

                            <DataGridTextColumn Header="품목명"
                                                Binding="{Binding ProductName}"
                                                Width="180"
                                                IsReadOnly="True" />    

                            <DataGridTextColumn Header="발주수량"
                                                Binding="{Binding LotQty, StringFormat={}{0:N0}}"
                                                Width="90"
                                                IsReadOnly="True" />    

                            <DataGridTextColumn Header="현재고"
                                                Binding="{Binding CurrentStockQty, StringFormat={}{0:N0}}"
                                                Width="90"
                                                IsReadOnly="True" />    

                            <DataGridTextColumn Header="공정"
                                                Binding="{Binding ProcessText}"
                                                Width="120"
                                                IsReadOnly="True" />    
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- 상단 목록 높이 조금 축소 -->
                    <RowDefinition Height="0.72*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="1.28*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="추가된 작업지시 목록">
                    <DockPanel Margin="8">
                        <Button DockPanel.Dock="Bottom"
                                Height="32"
                                Margin="0,8,0,0"
                                Content="선택 작업지시 제거"
                                Command="{Binding RemoveDraftCommand}" />

                        <DataGrid ItemsSource="{Binding Drafts}"
                                  SelectedItem="{Binding SelectedDraft}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="작업일" Binding="{Binding InstructionDate, StringFormat=yyyy-MM-dd}" Width="100" />
                                <DataGridTextColumn Header="구분" Binding="{Binding BundleText}" Width="60" />
                                <DataGridTextColumn Header="거래처" Binding="{Binding CustomerPartnerName}" Width="130" />
                                <DataGridTextColumn Header="LOT" Binding="{Binding LotSummary}" Width="180" />
                                <DataGridTextColumn Header="판사이즈" Binding="{Binding PlateSize}" Width="90" />
                                <DataGridTextColumn Header="규격" Binding="{Binding Spec}" Width="90" />
                                <DataGridTextColumn Header="컷수" Binding="{Binding CutCountText}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Row="2" Header="작업지시 상세">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 판데이터 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    Padding="6,6"
                                    MinHeight="32">
                                <TextBlock Text="{Binding SelectedDraft.PlateDataPath}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Border>

                            <Button Grid.Column="2"
                                    Height="32"
                                    Content="판데이터 첨부"
                                    Command="{Binding UploadFileCommand}" />
                        </Grid>

                        <!-- 작업 조건 -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="m수" />
                            <TextBox Grid.Column="1"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedDraft.LengthM, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N0}}" />

                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="매수" />
                            <TextBox Grid.Column="4"
                                     Height="30"
                                     IsReadOnly="True"
                                     Background="#F5F5F5"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedDraft.SheetQty, StringFormat={}{0:N0}}" />

                            <TextBlock Grid.Column="6"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="총 컷수" />
                            <TextBox Grid.Column="7"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedDraft.SheetCutCount, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="8"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#6B7280"
                                       Text="개별은 DB 컷수 사용 / 묶음은 직접 입력" />
                        </Grid>

                        <!-- 계산수량 / 원단 LOT -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="계산수량" />   

                            <TextBox Grid.Column="1"
                                     Height="30"
                                     IsReadOnly="True"
                                     Background="#F5F5F5"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedDraft.ExpectedOutputQty, Mode=OneWay, StringFormat={}{0:N0}}" /> 

                            <TextBlock Grid.Column="3"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="원단LOT" />      

                            <TextBox Grid.Column="4"
                                     Height="30"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding SelectedDraft.FabricLotNo, UpdateSourceTrigger=PropertyChanged}" />

                        </Grid>

                        <!-- 메모 -->
                        <TextBlock Grid.Row="8"
                                   Text="메모"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />

                        <TextBox Grid.Row="10"
                                 Height="42"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding SelectedDraft.Memo, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- 선택 LOT -->
                        <Grid Grid.Row="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="10" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Padding="10,8"
                                    Background="#F8FAFC"
                                    BorderBrush="#D0D7DE"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="선택 LOT"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="2"
                                               Foreground="#374151"
                                               VerticalAlignment="Center"
                                               Text="{Binding SelectedDraft.RepresentativeLotText}"
                                               TextTrimming="CharacterEllipsis" />

                                    <Button Grid.Column="4"
                                            Width="128"
                                            Height="32"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="대표품목 지정"
                                            Command="{Binding SetRepresentativeLotCommand}" />
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="2"
                                      Margin="0,0,0,8"
                                      ItemsSource="{Binding SelectedDraft.Lots}"
                                      SelectedItem="{Binding SelectedDraft.SelectedLot, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      MinHeight="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="대표"
                                                        Binding="{Binding RepresentativeMarker}"
                                                        Width="45"
                                                        IsReadOnly="True" />
                                    <DataGridTextColumn Header="LOT" Binding="{Binding LotNo}" Width="95" IsReadOnly="True" />
                                    <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="135" IsReadOnly="True" />
                                    <DataGridTextColumn Header="수량" Binding="{Binding LotQty, StringFormat={}{0:N0}}" Width="55" IsReadOnly="True" />
                                    <DataGridTextColumn Header="공정" Binding="{Binding ProcessText}" Width="65" IsReadOnly="True" />
                                    <DataGridTextColumn Header="기본컷수" Binding="{Binding CutCountText}" Width="62" IsReadOnly="True" />
                                    <DataGridTextColumn Header="묶음컷수"
                                                        Binding="{Binding ManualCutsPerSheet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                        Width="72" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="초기화"
                    Command="{Binding ResetCommand}" />
            <Button Width="120"
                    Height="32"
                    Content="작업지시 저장"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>

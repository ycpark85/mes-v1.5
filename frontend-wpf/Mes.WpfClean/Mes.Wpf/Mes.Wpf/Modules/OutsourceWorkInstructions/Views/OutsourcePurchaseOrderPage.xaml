<UserControl x:Class="Mes.Wpf.Modules.OutsourceWorkInstructions.Views.OutsourcePurchaseOrderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="CutPanelStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCutBundleSelected}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrintPanelStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCutBundleSelected}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <SolidColorBrush x:Key="PageBorderBrush" Color="#D7DEE7" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#DCE3EC" />
        <SolidColorBrush x:Key="LightFillBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TableLineBrush" Color="#BFC8D4" />
        <SolidColorBrush x:Key="HeaderFillBrush" Color="#F3F6FA" />
        <SolidColorBrush x:Key="InputFillBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TitleAccentBrush" Color="#1F2937" />

        <Style x:Key="FormBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource TableLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style x:Key="FormHeaderBorderStyle" TargetType="Border" BasedOn="{StaticResource FormBorderStyle}">
            <Setter Property="Background" Value="{StaticResource HeaderFillBrush}" />
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="CenteredTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#374151" />
        </Style>

        <Style x:Key="BundleListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EEF6FF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.72*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.58*" />
            </Grid.ColumnDefinitions>

            <!-- 왼쪽 -->
            <GroupBox Grid.Column="0"
                      Header="등록된 작업지시 묶음 목록">
                <ListBox ItemsSource="{Binding Bundles}"
                         SelectedItem="{Binding SelectedBundle}"
                         Margin="8"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource BundleListItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Background="White"
                                    HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#111827"
                                                   Text="{Binding Title}" />

                                        <Border Grid.Column="1"
                                                Padding="10,4"
                                                Margin="10,0,0,0"
                                                Background="#F3F0FF"
                                                BorderBrush="#D6CCFF"
                                                BorderThickness="1"
                                                CornerRadius="14">
                                            <TextBlock Foreground="#5B47C4"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding LotCount, StringFormat={}{0} LOT}" />
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="2"
                                            Padding="10"
                                            Background="#FAFBFC"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      MaxHeight="170">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProductCodesText, StringFormat=품목코드: {0}}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding MesProductCodesText, StringFormat=MES 코드: {0}}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,6"/>
                                            <TextBlock Margin="0,0,20,0"
                                                       Foreground="#4B5563"
                                                       Text="{Binding LotSummary}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="22" />
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <!-- 오른쪽 -->
            <Border Grid.Column="2"
        BorderBrush="{StaticResource PageBorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="16"
        Background="#F7F8FA">

                <Grid>
                    <!-- CUT 화면 -->
                    <Grid Style="{StaticResource CutPanelStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
                            <Border Width="980"
                MinHeight="1380"
                Padding="20"
                Background="White"
                BorderBrush="#D6DCE5"
                BorderThickness="1.2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 제목 -->
                                    <Border Grid.Row="0"
                                            Width="320"
                                            Height="62"
                                            HorizontalAlignment="Center"
                                            BorderBrush="#374151"
                                            BorderThickness="2"
                                            Background="White"> 
                                        <TextBlock Text="{Binding CutEditModel.Title}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="#111827" />  
                                    </Border>

                                    <!-- 헤더 -->
                                    <Grid Grid.Row="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="46" />
                                            <RowDefinition Height="46" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="320" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource FormHeaderBorderStyle}">
                                            <TextBlock Text="업체명"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" /> 
                                        </Border>

                                        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource FormBorderStyle}">
                                            <TextBox Text="{Binding CutEditModel.CompanyName}"
                                                     Style="{StaticResource CenteredTextBoxStyle}"
                                                     FontSize="12"
                                                     FontWeight="SemiBold" />   
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FormHeaderBorderStyle}">
                                            <TextBlock Text="의뢰업체"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />     
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FormBorderStyle}">
                                            <TextBox Text="{Binding CutEditModel.RequestPartnerName}"
                                                     Style="{StaticResource CenteredTextBoxStyle}"
                                                     FontSize="12"
                                                     FontWeight="SemiBold" />       
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource FormBorderStyle}">
                                            <TextBox Text="{Binding CutEditModel.RequesterName}"
                                                     Style="{StaticResource CenteredTextBoxStyle}"
                                                     FontSize="12"
                                                     FontWeight="SemiBold" />   
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource FormBorderStyle}">
                                            <TextBox Text="{Binding CutEditModel.RequestDate, StringFormat=yyyy-MM-dd}"
                                                     Style="{StaticResource CenteredTextBoxStyle}"
                                                     FontSize="12"
                                                     FontWeight="SemiBold"
                                                     IsReadOnly="True" />       
                                        </Border>
                                    </Grid>

                                    <!-- 본문 -->
                                    <Grid Grid.Row="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="46" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource FormHeaderBorderStyle}">
                                                <TextBlock Text="원단 입고"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />     
                                            </Border>

                                            <Border Grid.Column="1" Style="{StaticResource FormBorderStyle}">
                                                <TextBox Text="{Binding CutEditModel.RawMaterialInboundText}"
                                                         Style="{StaticResource FormTextBoxStyle}"
                                                         FontSize="12" />   
                                            </Border>
                                        </Grid>

                                        <Border Grid.Row="2"
                                                BorderBrush="{StaticResource TableLineBrush}"
                                                BorderThickness="1"
                                                Background="White">     
                                            <DataGrid ItemsSource="{Binding CutEditModel.Items}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      HeadersVisibility="Column"
                                                      RowHeaderWidth="0"
                                                      GridLinesVisibility="All"
                                                      BorderThickness="0"
                                                      FontSize="12"
                                                      VerticalAlignment="Top"
                                                      MinRowHeight="36"
                                                      RowHeight="36"
                                                      AlternatingRowBackground="#FBFCFD"
                                                      RowBackground="White">        
                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader">
                                                        <Setter Property="Background" Value="#F3F6FA" />
                                                        <Setter Property="Foreground" Value="#111827" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="FontSize" Value="12" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource TableLineBrush}" />
                                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                                        <Setter Property="Padding" Value="6,4" />
                                                    </Style>
                                                </DataGrid.ColumnHeaderStyle>

                                                <DataGrid.CellStyle>
                                                    <Style TargetType="DataGridCell">
                                                        <Setter Property="BorderBrush" Value="{StaticResource TableLineBrush}" />
                                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                                        <Setter Property="Padding" Value="4,2" />
                                                        <Setter Property="FontSize" Value="12" />
                                                        <Setter Property="TextBlock.TextAlignment" Value="Center" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    </Style>
                                                </DataGrid.CellStyle>
                                                <DataGrid.Resources>
                                                    <Style x:Key="CenterTextBlockStyle" TargetType="TextBlock">
                                                        <Setter Property="TextAlignment" Value="Center" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                    </Style>

                                                    <Style x:Key="CenterTextBoxStyle" TargetType="TextBox">
                                                        <Setter Property="TextAlignment" Value="Center" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    </Style>
                                                </DataGrid.Resources>



                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="No."
                                                                        Binding="{Binding No}"
                                                                        Width="60"
                                                                        IsReadOnly="True" 
                                                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                                                    <DataGridTextColumn Header="원단"
                                                                        Binding="{Binding RawMaterialText}"
                                                                        Width="170"
                                                                        IsReadOnly="True"
                                                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>      
                                                    <DataGridTextColumn Header="m 수(길이)"
                                                                        Binding="{Binding LengthMDisplay}"
                                                                        Width="130"
                                                                        IsReadOnly="True"
                                                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>  
                                                    <DataGridTextColumn Header="입고처"
                                                                        Binding="{Binding InboundPlaceDisplay, Mode=OneWay}"
                                                                        Width="300"
                                                                        IsReadOnly="True"
                                                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>
                                                    <DataGridTextColumn Header="재단규격"
                                                                        Binding="{Binding CutSpec}"
                                                                        Width="150"
                                                                        IsReadOnly="True"
                                                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>      
                                                    <DataGridTextColumn Header="매수"
                                                                        Binding="{Binding SheetQtyDisplay}"
                                                                        Width="*"
                                                                        IsReadOnly="True"
                                                                        ElementStyle="{StaticResource CenterTextBlockStyle}"/>  
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </Grid>

                                    <!-- 작업 후 재고 -->
                                    <Grid Grid.Row="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="50" />
                                            <RowDefinition Height="56" />
                                            <RowDefinition Height="56" />
                                            <RowDefinition Height="44" />
                                            <RowDefinition Height="120" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource FormHeaderBorderStyle}">
                                            <TextBlock Text="작업 후 재고"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#111827" />
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource FormHeaderBorderStyle}">
                                            <TextBlock Text="구분"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource FormHeaderBorderStyle}">
                                            <TextBlock Text="500폭"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource FormHeaderBorderStyle}">
                                            <TextBlock Text="600폭"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource FormHeaderBorderStyle}">
                                            <TextBlock Text="600폭_TPT-0268"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                                        </Border>

                                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource FormBorderStyle}">
                                            <TextBox Text="{Binding CutEditModel.Stock500Width, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CenteredTextBoxStyle}"
                                 FontSize="12"
                                 FontWeight="SemiBold" />
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource FormBorderStyle}">
                                            <TextBox Text="{Binding CutEditModel.Stock600Width, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CenteredTextBoxStyle}"
                                 FontSize="12"
                                 FontWeight="SemiBold" />
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource FormBorderStyle}">
                                            <TextBox Text="{Binding CutEditModel.Stock600Tpt0268, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CenteredTextBoxStyle}"
                                 FontSize="12"
                                 FontWeight="SemiBold" />
                                        </Border>

                                        <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource FormHeaderBorderStyle}">
                                            <TextBlock Text="비고"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                                        </Border>

                                        <Border Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FormBorderStyle}">
                                            <TextBox Text="{Binding CutEditModel.Remark, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 FontSize="12" />
                                        </Border>

                                        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Style="{StaticResource FormBorderStyle}">
                                            <TextBox Text="{Binding CutEditModel.Remark, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="10"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 FontSize="12" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </Grid>

                    <!-- PRINT -->
                    <Grid Style="{StaticResource PrintPanelStyle}">
                        <Border BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Background="{StaticResource LightFillBrush}">       
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 제목 -->
                                <Border Grid.Row="0"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        Background="White"
                                        Padding="0,10"
                                        Margin="0,0,0,12">      
                                    <TextBlock Text="가공의뢰서_인쇄"
                                               HorizontalAlignment="Center"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="Black" />        
                                </Border>

                                <!-- 헤더 -->
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="White" Padding="8">
                                        <TextBlock Text="업체명" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="1" Background="White" Padding="4">
                                        <TextBox Text="{Binding PrintEditModel.VendorName, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center" />
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="2" BorderBrush="Black" BorderThickness="1" Background="White" Padding="8">
                                        <TextBlock Text="의뢰일자" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="3" BorderBrush="Black" BorderThickness="1" Background="White" Padding="8">
                                        <TextBlock Text="{Binding PrintEditModel.PurchaseOrderDate, StringFormat=yyyy-MM-dd}"
                               VerticalAlignment="Center" />
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="Black" BorderThickness="1" Background="White" Padding="8">
                                        <TextBlock Text="의뢰업체" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="1" Background="White" Padding="8">
                                        <TextBlock Text="{Binding PrintEditModel.RequestCompanyName}"
                               VerticalAlignment="Center" />
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="Black" BorderThickness="1" Background="White" Padding="8">
                                        <TextBlock Text="의뢰자" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="3" BorderBrush="Black" BorderThickness="1" Background="White" Padding="8">
                                        <TextBlock Text="{Binding PrintEditModel.RequesterName}"
                               VerticalAlignment="Center" />
                                    </Border>
                                </Grid>

                                <!-- 본문 -->
                                <DataGrid Grid.Row="3"
                                          ItemsSource="{Binding PrintEditModel.Items}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="All"
                                          RowHeaderWidth="0"
                                          BorderBrush="Black"
                                          BorderThickness="1"
                                          Background="White"
                                          AlternatingRowBackground="White"
                                          Height="340"
                                          MaxHeight="340"
                                          Width="Auto"
                                          ScrollViewer.CanContentScroll="True"
                                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                                          ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                          IsReadOnly="False">          
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NO"
                                        Binding="{Binding No}"
                                        IsReadOnly="True"
                                        Width="50" />
                                        <DataGridTextColumn Header="업체명"
                                        Binding="{Binding CustomerName}"
                                        IsReadOnly="True"
                                        Width="150" />
                                        <DataGridTextColumn Header="품목명"
                                        Binding="{Binding ProductName}"
                                        IsReadOnly="True"
                                        Width="180" />
                                        <DataGridTextColumn Header="원단규격"
                                        Binding="{Binding MaterialSpec}"
                                        IsReadOnly="True"
                                        Width="120" />
                                        <DataGridTextColumn Header="인쇄수량"
                                        Binding="{Binding PrintSheetQty}"
                                        IsReadOnly="True"
                                        Width="90" />
                                        <DataGridTextColumn Header="샘플"
                                        Binding="{Binding Sample, UpdateSourceTrigger=PropertyChanged}"
                                        Width="70" />
                                        <DataGridTextColumn Header="도수"
                                        Binding="{Binding PlateCount, UpdateSourceTrigger=PropertyChanged}"
                                        Width="70" />
                                        <DataGridTextColumn Header="색상"
                                        Binding="{Binding ColorName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="90" />
                                        <DataGridTextColumn Header="원단종류"
                                        Binding="{Binding MaterialType, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110" />
                                        <DataGridTextColumn Header="비고"
                                        Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                        Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- 하단 비고 -->
                                <Grid Grid.Row="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Background="White"
                        Padding="8">
                                        <TextBlock Text="하단 비고"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top" />
                                    </Border>

                                    <Border Grid.Column="1"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Background="White"
                        Padding="4">
                                        <TextBox Text="{Binding PrintEditModel.FooterRemark, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="70"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Top" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="새로고침"
                    Command="{Binding RefreshCommand}" />
            <Button Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="초기화"
                    Command="{Binding ResetCommand}" />
            <Button Width="90"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="저장"
                    Command="{Binding SaveCommand}" />
            
        </StackPanel>
    </Grid>
</UserControl>

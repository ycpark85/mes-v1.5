<UserControl x:Class="Mes.Wpf.Modules.Partners.Views.PartnerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Mes.Wpf.Core.Controls"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1400">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="1.4*"/>
        </Grid.RowDefinitions>

        <!-- 검색 영역 -->
        <Border Grid.Row="0"
                Padding="16,12"
                BorderBrush="#DDD" 
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="검색어"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Column="1"
                         Height="30"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           Text="사용여부"
                           FontWeight="SemiBold"/>

                <ComboBox Grid.Column="4"
                          Height="30"
                          ItemsSource="{Binding UseYnOptions}"
                          SelectedItem="{Binding SelectedUseYn}" />

                <Button Grid.Column="6"
                        Width="90"
                        Height="30"
                        HorizontalAlignment="Right"
                        Content="조회"
                        Command="{Binding SearchCommand}" />

                <Button Grid.Column="8"
                        Width="90"
                        Height="30"
                        HorizontalAlignment="Right"
                        Content="초기화"
                        Command="{Binding ResetCommand}" />

                <Button Grid.Column="10"
                        Width="90"
                        Height="30"
                        HorizontalAlignment="Right"
                        Content="신규"
                        Command="{Binding NewCommand}" />
            </Grid>
        </Border>

        <!-- 목록/편집 영역 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="12"
                    BorderBrush="#DDD" 
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="거래처 목록"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <DataGrid Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Width="80"
                                                Binding="{Binding PartnerId}" />
                            <DataGridTextColumn Header="구분"
                                                Width="120"
                                                Binding="{Binding PartnerType}" />
                            <DataGridTextColumn Header="거래처명"
                                                Width="*"
                                                Binding="{Binding Name}" />
                            <DataGridTextColumn Header="사업자번호"
                                                Width="180"
                                                Binding="{Binding BusinessNo}" />
                            <DataGridCheckBoxColumn Header="사용"
                                                    Width="80"
                                                    Binding="{Binding IsActive}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <controls:PaginationBar Grid.Row="3"
                                            PageText="{Binding ListPageDisplayText}"
                                            PreviousCommand="{Binding ListPreviousPageCommand}"
                                            NextCommand="{Binding ListNextPageCommand}"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="16"
                    BorderBrush="#DDD" 
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Grid.ColumnSpan="2"
                               Text="거래처 편집"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="거래처구분"
                               FontWeight="SemiBold"/>
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              Height="30"
                              ItemsSource="{Binding PartnerTypeOptions}"
                              SelectedItem="{Binding EditModel.PartnerType}" />

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="거래처명"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             Height="30"
                             VerticalContentAlignment="Center"
                             Text="{Binding EditModel.Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="사업자번호"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="6"
                             Grid.Column="1"
                             Height="30"
                             VerticalContentAlignment="Center"
                             Text="{Binding EditModel.BusinessNo, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="8"
                               Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="사용여부"
                               FontWeight="SemiBold"/>
                    <CheckBox Grid.Row="8"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              IsChecked="{Binding EditModel.IsActive}" />

                    <StackPanel Grid.Row="10"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Width="100"
                                Height="32"
                                Margin="0,0,8,0"
                                Content="저장"
                                Command="{Binding SaveCommand}" />
                        <Button Width="100"
                                Height="32"
                                Content="삭제"
                                Command="{Binding DeleteCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 벌크 업로드 영역 -->
        <Border Grid.Row="4"
                Padding="16"
                BorderBrush="#DDD" 
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="벌크 업로드"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Height="30"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             Text="{Binding BulkFilePath}" />

                    <Button Grid.Column="2"
                            Height="30"
                            Content="템플릿 저장"
                            Command="{Binding DownloadTemplateCommand}" />

                    <Button Grid.Column="4"
                            Height="30"
                            Content="파일 선택"
                            Command="{Binding SelectBulkFileCommand}" />

                    <Button Grid.Column="6"
                            Height="30"
                            Content="업로드 실행"
                            Command="{Binding UploadBulkCommand}" />

                    <Button Grid.Column="8"
                            Height="30"
                            Content="목록 비움"
                            Command="{Binding ClearBulkRowsCommand}" />
                </Grid>

                <Border Grid.Row="4"
                        Padding="10,6"
                        BorderBrush="#DDD" 
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBlock Text="{Binding BulkSummaryText}"
                               FontWeight="SemiBold"
                               Foreground="#1F3B64"/>
                </Border>

                <DataGrid Grid.Row="6"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding BulkRows}"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                    <Setter Property="Background" Value="#FDECEC"/>
                                    <Setter Property="Foreground" Value="#9C1C1C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="행"
                                            Width="70"
                                            Binding="{Binding RowNumber}" />
                        <DataGridTextColumn Header="구분"
                                            Width="120"
                                            Binding="{Binding PartnerType}" />
                        <DataGridTextColumn Header="거래처명"
                                            Width="*"
                                            Binding="{Binding Name}" />
                        <DataGridTextColumn Header="사업자번호"
                                            Width="180"
                                            Binding="{Binding BusinessNo}" />
                        <DataGridCheckBoxColumn Header="사용"
                                                Width="80"
                                                Binding="{Binding IsActive}" />
                        <DataGridCheckBoxColumn Header="유효"
                                                Width="80"
                                                Binding="{Binding IsValid}" />
                        <DataGridTextColumn Header="오류메시지"
                                            Width="260"
                                            Binding="{Binding ErrorMessage}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 로딩 오버레이 -->
        <Border Grid.RowSpan="5"
                Panel.ZIndex="100"
                Background="#66000000">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Border Width="280"
                        Padding="24"
                        Background="White"
                        CornerRadius="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <Grid Width="64"
                              Height="64"
                              Margin="0,0,0,14"
                              HorizontalAlignment="Center">
                            <Ellipse Stroke="#D6E4FF"
                                     StrokeThickness="6"/>

                            <Ellipse Stroke="#2563EB"
                                     StrokeThickness="6"
                                     StrokeDashArray="2 3"
                                     StrokeStartLineCap="Round"
                                     StrokeEndLineCap="Round">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate"
                                                     CenterX="32"
                                                     CenterY="32"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0"
                                                             To="360"
                                                             Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                        </Grid>

                        <TextBlock Text="{Binding LoadingMessage}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
